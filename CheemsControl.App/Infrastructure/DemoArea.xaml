<UserControl x:Class="CheemsControl.App.Infrastructure.DemoArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cheems="https://cheemscontrol.com/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="400">
    <!--
      展示台：浅 #E8E8E8 / 深 #212121 可切换，默认浅色。
      切换器（昼夜开关）必须是舞台 Border 的内容子元素——曾作为与舞台同格重叠的兄弟悬浮层，
      逐帧动画导致渲染线程栈溢出崩溃（详见 CONVENTIONS C6）。
    -->
    <Border x:Name="PartStage"
            CornerRadius="6"
            Padding="16"
            MinHeight="96">
        <Border.Background>
            <SolidColorBrush x:Name="PartStageBrush" Color="#FFE8E8E8" />
        </Border.Background>
        <Grid>
            <ContentPresenter Content="{Binding Demo, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Margin="0,26,0,0" />

            <!-- 切换器：昼夜开关（checked = 夜晚 = 深色），置于舞台内右上角 -->
            <cheems:CheemsDayNightSwitch Width="52" Height="26"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,-6,-10,0"
                                         Checked="Switch_Toggled"
                                         Unchecked="Switch_Toggled" />
        </Grid>
    </Border>
</UserControl>
