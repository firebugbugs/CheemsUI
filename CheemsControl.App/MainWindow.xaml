<Window x:Class="CheemsControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="clr-namespace:CheemsControl.App.Pages"
        xmlns:vm="clr-namespace:CheemsControl.App.ViewModels"
        mc:Ignorable="d"
        Title="CheemsControl Demo"
        Height="650" Width="1000"
        Background="{DynamicResource Cheems.Brush.Background.Default}"
        FontFamily="{DynamicResource Cheems.FontFamily.Default}">
    <Window.Resources>
        <!-- VM → View 映射集中注册（规矩 M2）：新增控件类型在此加一行 -->
        <DataTemplate DataType="{x:Type vm:ButtonsViewModel}">
            <pages:ButtonsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoadersViewModel}">
            <pages:LoadersPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InputsViewModel}">
            <pages:InputsPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：控件类型菜单 -->
        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Groups}"
                 SelectedItem="{Binding SelectedGroup}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="8,12">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               Padding="12,10"
                               TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1"
                Width="1"
                Background="{DynamicResource Cheems.Brush.Border.Default}"
                Margin="0,12,0,12" />

        <!-- 右侧：当前类型页面 -->
        <ContentControl Grid.Column="2"
                        Margin="20,16"
                        Content="{Binding SelectedGroup.PageViewModel}" />
    </Grid>
</Window>
