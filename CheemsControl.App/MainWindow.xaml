<Window x:Class="CheemsControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:CheemsControl.App.Infrastructure"
        xmlns:pages="clr-namespace:CheemsControl.App.Pages"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:CheemsControl.App.ViewModels"
        mc:Ignorable="d"
        Title="CheemsControl Demo"
        Height="720" Width="1120"
        MinHeight="560" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Background="#E8E8E8"
        WindowStyle="None"
        FontFamily="{DynamicResource Cheems.FontFamily.Default}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WelcomeViewModel}"><pages:WelcomePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ButtonsViewModel}"><pages:ButtonsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoadersViewModel}"><pages:LoadersPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InputsViewModel}"><pages:InputsPage /></DataTemplate>

        <SolidColorBrush x:Key="App.Sidebar.Background" Color="#F5F5F5" />
        <SolidColorBrush x:Key="App.Navigation.Hover" Color="#ECECEC" />
        <SolidColorBrush x:Key="App.Navigation.Selected" Color="#FFFFFF" />
        <SolidColorBrush x:Key="App.Text.Primary" Color="#202124" />
        <SolidColorBrush x:Key="App.Text.Secondary" Color="#74777C" />
        <SolidColorBrush x:Key="App.Accent" Color="#202124" />

        <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#4D4F53" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#DCDCDC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#D2D2D2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface" Background="Transparent" CornerRadius="8">
                            <ContentPresenter x:Name="ButtonContent"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#D94A4A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#BE3434" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBackground" MinHeight="46" Background="Transparent" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SelectionMark" Width="4" Height="20"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{StaticResource App.Accent}"
                                        CornerRadius="0,3,3,0" Opacity="0" />
                                <ContentPresenter Grid.Column="1" Margin="13,0,12,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource App.Navigation.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource App.Navigation.Selected}" />
                                <Setter TargetName="SelectionMark" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            Background="#E8E8E8"
            BorderBrush="#D1D1D1">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                 Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12,4,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" Background="#202124" CornerRadius="7">
                        <TextBlock Text="C" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center"
                               Text="CheemsControl" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource App.Text.Primary}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                               Text="组件展示" FontSize="11"
                               Foreground="{StaticResource App.Text.Secondary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="MinimizeButton_Click" AutomationProperties.Name="最小化">
                        <Path Width="10" Height="1" Stretch="Fill" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M 0,0 L 10,0 L 10,1 L 0,1 Z" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="MaximizeRestoreButton_Click" AutomationProperties.Name="最大化或还原">
                        <Border Width="10" Height="10" BorderThickness="1"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                            Click="CloseButton_Click" AutomationProperties.Name="关闭">
                        <Path Width="10" Height="10" Stretch="Fill"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="18,8,18,18"
                Background="{StaticResource App.Sidebar.Background}" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.10"
                                  ShadowDepth="4" Color="#000000" />
            </Border.Effect>
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <infra:SidebarBrandControl Width="160" Height="62"
                                           Margin="0,1,0,11"
                                           HorizontalAlignment="Center"
                                           AutomationProperties.Name="CheemsUI，cheems.cn" />

                <StackPanel Grid.Row="1" Margin="2,0,2,14">
                    <TextBlock Margin="8,0,8,7" Text="搜索控件"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource App.Text.Secondary}" />
                    <Border Height="38" Background="#FFFFFF" CornerRadius="11"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Stroke="#777A7F" StrokeThickness="1.5"
                                  Data="M 8.5,8.5 L 13,13 M 11,5.5 A 5.5,5.5 0 1 1 0,5.5 A 5.5,5.5 0 1 1 11,5.5" />
                            <TextBox Grid.Column="1" Margin="9,0,9,0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="12" Foreground="{StaticResource App.Text.Primary}"
                                     CaretBrush="{StaticResource App.Text.Primary}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2" Margin="10,2,10,7" Text="组件"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource App.Text.Secondary}" />

                <ListBox Grid.Row="3" ItemsSource="{Binding GroupsView}"
                         SelectedItem="{Binding SelectedGroup}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource App.Text.Primary}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="4" Margin="2,14,2,2" Padding="12,10"
                        Background="#ECECEC" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="CheemsControl" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource App.Text.Primary}" />
                        <TextBlock Text="CSS → WPF component gallery" Margin="0,3,0,0"
                                   FontSize="10" Foreground="{StaticResource App.Text.Secondary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Margin="20,18,28,22"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding SelectedGroup.PageViewModel}" />
            </Grid>

            <!-- 全局提示层：当前页面的 BaseViewModel 控制文本与三秒可见期。 -->
            <Border Grid.RowSpan="2"
                    Panel.ZIndex="10"
                    MaxWidth="420"
                    Margin="24,0,24,32"
                    Padding="18,11"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#FFFFFF"
                    BorderBrush="#D6D9DE"
                    BorderThickness="1"
                    CornerRadius="10"
                    IsHitTestVisible="False"
                    Visibility="{Binding SelectedGroup.PageViewModel.IsNotificationVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      Direction="270"
                                      Opacity="0.16"
                                      ShadowDepth="5"
                                      Color="#000000" />
                </Border.Effect>
                <TextBlock Text="{Binding SelectedGroup.PageViewModel.NotificationMessage}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource App.Text.Primary}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Border>
</Window>
