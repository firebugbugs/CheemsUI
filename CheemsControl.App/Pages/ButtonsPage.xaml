<UserControl x:Class="CheemsControl.App.Pages.ButtonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cheems="https://cheemscontrol.com/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:CheemsControl.App.Infrastructure"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,16">

            <TextBlock Text="按钮 Button"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Cheems.Brush.Text.Primary}" />
            <TextBlock Text="按钮均按原始 HTML/CSS 移植；简单控件使用透明横向展示器，每个控件只保留一个代表实例。"
                       Margin="0,8,0,24"
                       FontSize="13"
                       Foreground="{DynamicResource Cheems.Brush.Text.Secondary}"
                       TextWrapping="Wrap" />

            <WrapPanel>
                <infra:CompactShowcaseControl Source="/CheemsControl.App;component/Sources/Buttons/DashedButton.xaml.txt"
                                              Margin="0,0,32,28">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsDashedButton Content="BUTTON" />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsControl.App;component/Sources/Buttons/SoftButton.xaml.txt"
                                              Margin="0,0,32,28">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsSoftButton Content="Click me" />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
