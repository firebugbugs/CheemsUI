<UserControl x:Class="CheemsControl.App.Pages.LoadersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cheems="https://cheemscontrol.com/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:CheemsControl.App.Infrastructure"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,16">
            <TextBlock Text="加载 Loader" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource Cheems.Brush.Text.Primary}"/>
            <TextBlock Text="每个加载动画只展示一个原始形态，并使用透明横向小容器；页面空间允许时自动并排。"
                       Margin="0,8,0,24" FontSize="13"
                       Foreground="{DynamicResource Cheems.Brush.Text.Secondary}" TextWrapping="Wrap"/>

            <WrapPanel>
                <infra:CompactShowcaseControl Source="/CheemsControl.App;component/Sources/Loaders/Typewriter.xaml.txt" Margin="0,0,32,28">
                    <infra:CompactShowcaseControl.Demo><cheems:CheemsTypewriterLoader Width="136" Height="94"/></infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>
                <infra:CompactShowcaseControl Source="/CheemsControl.App;component/Sources/Loaders/WashingMachine.xaml.txt" Margin="0,0,32,28">
                    <infra:CompactShowcaseControl.Demo><cheems:CheemsWashingMachineLoader Width="124" Height="158"/></infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>
                <infra:CompactShowcaseControl Source="/CheemsControl.App;component/Sources/Loaders/AiMatrix.xaml.txt" Margin="0,0,32,28">
                    <infra:CompactShowcaseControl.Demo><cheems:CheemsAiMatrixLoader/></infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>
                <infra:CompactShowcaseControl Source="/CheemsControl.App;component/Sources/Loaders/HamsterWheel.xaml.txt" Margin="0,0,32,28">
                    <infra:CompactShowcaseControl.Demo><cheems:CheemsHamsterWheelLoader/></infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>
                <infra:CompactShowcaseControl Source="/CheemsControl.App;component/Sources/Loaders/CubeLoading.xaml.txt" Margin="0,0,32,28">
                    <infra:CompactShowcaseControl.Demo><cheems:CheemsCubeLoadingLoader/></infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
