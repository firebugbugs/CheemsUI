        <GradientStop Offset="1" Color="{StaticResource Cheems.Color.LedSwitch.ToggleOffEnd}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Cheems.Brush.LedSwitch.ToggleOn" StartPoint="0.15,0" EndPoint="0.85,1">
        <GradientStop Offset="0" Color="{StaticResource Cheems.Color.LedSwitch.ToggleOnStart}" />
        <GradientStop Offset="1" Color="{StaticResource Cheems.Color.LedSwitch.ToggleOnEnd}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Cheems.Brush.LedSwitch.ShadowLight" Color="{StaticResource Cheems.Color.LedSwitch.ShadowLight}" />
    <SolidColorBrush x:Key="Cheems.Brush.LedSwitch.ShadowOffDark" Color="{StaticResource Cheems.Color.LedSwitch.ShadowOffDark}" />

