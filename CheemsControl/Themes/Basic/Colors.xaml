    <Color x:Key="Cheems.Color.Background.Default">#FFFFFFFF</Color>
    <Color x:Key="Cheems.Color.Background.Elevated">#FFF5F6FA</Color>
    <Color x:Key="Cheems.Color.Border.Default">#FFDFE6E9</Color>

