<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- L1 调色板：只允许 <Color>，键 Cheems.Color.*；语义化引用一律去 Brushes.xaml -->

    <!-- 品牌主色 -->
    <Color x:Key="Cheems.Color.Primary">#FF6C5CE7</Color>
    <Color x:Key="Cheems.Color.Primary.Hover">#FF5A4BD1</Color>
    <Color x:Key="Cheems.Color.Primary.Pressed">#FF4A3DB8</Color>
    <Color x:Key="Cheems.Color.Accent">#FF00CEC9</Color>

    <!-- 功能色 -->
    <Color x:Key="Cheems.Color.Danger">#FFD63031</Color>
    <Color x:Key="Cheems.Color.Success">#FF00B894</Color>
    <Color x:Key="Cheems.Color.Warning">#FFE8B30E</Color>

    <!-- 文本 -->
    <Color x:Key="Cheems.Color.Text.Primary">#FF2D3436</Color>
    <Color x:Key="Cheems.Color.Text.Secondary">#FF636E72</Color>
    <Color x:Key="Cheems.Color.Text.OnPrimary">#FFFFFFFF</Color>

