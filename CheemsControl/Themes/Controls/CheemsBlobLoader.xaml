<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsBlobLoader}">
        <!-- 112×112 原始盒外增加 6px blur 安全区。 -->
        <Setter Property="Width" Value="124" />
        <Setter Property="Height" Value="124" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsBlobLoader}">
                    <Grid Width="124" Height="124">
                        <!-- CSS blur(5.6px) 的共享图层：相邻方块在同一位图效果中发生黏连。 -->
                        <Canvas Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas.Effect><BlurEffect Radius="5.6" KernelType="Gaussian" /></Canvas.Effect>
                            <Rectangle x:Name="PartBlob1" Width="44.8" Height="44.8" Canvas.Left="11.2" Canvas.Top="11.2" Fill="{DynamicResource Cheems.Brush.BlobLoader.Blob}" />
                            <Rectangle x:Name="PartBlob2" Width="44.8" Height="44.8" Canvas.Left="11.2" Canvas.Top="11.2" Fill="{DynamicResource Cheems.Brush.BlobLoader.Blob}" />
                        </Canvas>

                        <!-- 高密度收边层用于模拟 contrast(10)，保留原始 #474bff。 -->
                        <Canvas Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas.Effect><BlurEffect Radius="2.2" KernelType="Gaussian" /></Canvas.Effect>
                            <Rectangle x:Name="PartBlob3" Width="44.8" Height="44.8" Canvas.Left="11.2" Canvas.Top="11.2" Fill="{DynamicResource Cheems.Brush.BlobLoader.Blob}" />
                            <Rectangle x:Name="PartBlob4" Width="44.8" Height="44.8" Canvas.Left="11.2" Canvas.Top="11.2" Fill="{DynamicResource Cheems.Brush.BlobLoader.Blob}" />
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
