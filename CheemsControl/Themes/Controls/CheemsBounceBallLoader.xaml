<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SineEase x:Key="Cheems.BounceBall.Ease" EasingMode="EaseInOut" />

    <!--
      DOM 一一对应：
      PartBall1/2/3 = .circle:nth-child(1/2/3)
      PartShadow1/2/3 = .shadow:nth-child(4/5/6)
      全部动画 0.5s alternate infinite ease，交错 delay: 0 / 0.2s / 0.3s。
    -->
    <Style TargetType="{x:Type local:CheemsBounceBallLoader}">
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsBounceBallLoader}">
                    <Canvas x:Name="RootCanvas" Width="200" Height="70" ClipToBounds="False">

                        <!-- ===== 阴影（先画，z-index 更低） ===== -->
                        <Ellipse x:Name="PartShadow1" Width="20" Height="4"
                                 Canvas.Left="30" Canvas.Top="62"
                                 Fill="#E6000000" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="1.5" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="PartShadow2" Width="20" Height="4"
                                 Canvas.Left="90" Canvas.Top="62"
                                 Fill="#E6000000" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="1.5" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="PartShadow3" Width="20" Height="4"
                                 Canvas.Left="150" Canvas.Top="62"
                                 Fill="#E6000000" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="1.5" /></Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- ===== 球体 ===== -->
                        <!-- Ball 1: left=15%=30px -->
                        <Border x:Name="PartBall1" Width="20" Height="5"
                                Canvas.Left="30" Canvas.Top="60"
                                CornerRadius="25,25,12.5,12.5" Background="White"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1.7" /></Border.RenderTransform>
                        </Border>
                        <!-- Ball 2: left=45%=90px -->
                        <Border x:Name="PartBall2" Width="20" Height="5"
                                Canvas.Left="90" Canvas.Top="60"
                                CornerRadius="25,25,12.5,12.5" Background="White"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1.7" /></Border.RenderTransform>
                        </Border>
                        <!-- Ball 3: right=15% → left=150px -->
                        <Border x:Name="PartBall3" Width="20" Height="5"
                                Canvas.Left="150" Canvas.Top="60"
                                CornerRadius="25,25,12.5,12.5" Background="White"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1.7" /></Border.RenderTransform>
                        </Border>

                        <!-- ===== 动画 ===== -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="BounceGroup">
                                <VisualState x:Name="Bounce">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <!-- Ball 1: delay=0 -->
                                        <DoubleAnimation Storyboard.TargetName="PartBall1"
                                                         Storyboard.TargetProperty="(Canvas.Top)"
                                                         From="60" To="0" Duration="0:0:0.5"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />
                                        <DoubleAnimation Storyboard.TargetName="PartBall1"
                                                         Storyboard.TargetProperty="Height"
                                                         From="5" To="20" Duration="0:0:0.5"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />
                                        <!-- DiscreteObjectKeyFrame.Value 是 object，必须显式给出 CornerRadius，
                                             否则值保持字符串、每个渲染 tick 抛 AnimationException -->
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartBall1"
                                                                       Storyboard.TargetProperty="CornerRadius">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <CornerRadius>25,25,12.5,12.5</CornerRadius>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <CornerRadius>10,10,10,10</CornerRadius>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.5">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <CornerRadius>10,10,10,10</CornerRadius>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PartBall1"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="1.7" To="1" Duration="0:0:0.5"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />

                                        <!-- Ball 2: delay=0.2s -->
                                        <DoubleAnimation Storyboard.TargetName="PartBall2"
                                                         Storyboard.TargetProperty="(Canvas.Top)"
                                                         From="60" To="0" Duration="0:0:0.5"
                                                         BeginTime="0:0:0.2"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />
                                        <DoubleAnimation Storyboard.TargetName="PartBall2"
                                                         Storyboard.TargetProperty="Height"
                                                         From="5" To="20" Duration="0:0:0.5"
                                                         BeginTime="0:0:0.2"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartBall2"
                                                                       Storyboard.TargetProperty="CornerRadius"
                                                                       BeginTime="0:0:0.2">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <CornerRadius>25,25,12.5,12.5</CornerRadius>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <CornerRadius>10,10,10,10</CornerRadius>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.5">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <CornerRadius>10,10,10,10</CornerRadius>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PartBall2"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="1.7" To="1" Duration="0:0:0.5"
                                                         BeginTime="0:0:0.2"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />

                                        <!-- Ball 3: delay=0.3s -->
                                        <DoubleAnimation Storyboard.TargetName="PartBall3"
                                                         Storyboard.TargetProperty="(Canvas.Top)"
                                                         From="60" To="0" Duration="0:0:0.5"
                                                         BeginTime="0:0:0.3"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />
                                        <DoubleAnimation Storyboard.TargetName="PartBall3"
                                                         Storyboard.TargetProperty="Height"
                                                         From="5" To="20" Duration="0:0:0.5"
                                                         BeginTime="0:0:0.3"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartBall3"
                                                                       Storyboard.TargetProperty="CornerRadius"
                                                                       BeginTime="0:0:0.3">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <CornerRadius>25,25,12.5,12.5</CornerRadius>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <CornerRadius>10,10,10,10</CornerRadius>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.5">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <CornerRadius>10,10,10,10</CornerRadius>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PartBall3"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="1.7" To="1" Duration="0:0:0.5"
                                                         BeginTime="0:0:0.3"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />

                                        <!-- Shadow 1: delay=0 -->
                                        <DoubleAnimation Storyboard.TargetName="PartShadow1"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="1.5" To="0.2" Duration="0:0:0.5"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />
                                        <DoubleAnimation Storyboard.TargetName="PartShadow1"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.4" Duration="0:0:0.5"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />

                                        <!-- Shadow 2: delay=0.2s -->
                                        <DoubleAnimation Storyboard.TargetName="PartShadow2"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="1.5" To="0.2" Duration="0:0:0.5"
                                                         BeginTime="0:0:0.2"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />
                                        <DoubleAnimation Storyboard.TargetName="PartShadow2"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.4" Duration="0:0:0.5"
                                                         BeginTime="0:0:0.2"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />

                                        <!-- Shadow 3: delay=0.3s -->
                                        <DoubleAnimation Storyboard.TargetName="PartShadow3"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="1.5" To="0.2" Duration="0:0:0.5"
                                                         BeginTime="0:0:0.3"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />
                                        <DoubleAnimation Storyboard.TargetName="PartShadow3"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.4" Duration="0:0:0.5"
                                                         BeginTime="0:0:0.3"
                                                         EasingFunction="{StaticResource Cheems.BounceBall.Ease}" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
