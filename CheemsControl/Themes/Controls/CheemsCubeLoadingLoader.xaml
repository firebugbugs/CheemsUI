<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <Style TargetType="{x:Type local:CheemsCubeLoadingLoader}">
        <Setter Property="Width" Value="336"/><Setter Property="Height" Value="76"/>
        <Setter Property="Focusable" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsCubeLoadingLoader}">
                    <Viewbox Stretch="Uniform">
                        <local:CheemsCubeLoadingSurface Width="336" Height="76"/>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
