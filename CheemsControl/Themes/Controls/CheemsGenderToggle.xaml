<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsGenderToggle}">
        <Setter Property="Width" Value="330" />
        <Setter Property="Height" Value="240" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsGenderToggle}">
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="PartRoot" Width="330" Height="240" Background="Transparent">
                            <!-- female / male 的 z-index:-1：先绘制，随后由白色轨道遮挡中段。 -->
                            <!-- 字体 †/➜ 的平台度量不稳定，使用与目标轮廓一致的固定矢量。 -->
                            <Path x:Name="PartFemale"
                                  Data="M 80.2,150 L 88.2,150 L 88.2,195 L 109.3,195 L 109.3,204 L 88.2,204 L 88.2,232 L 80.2,232 L 80.2,204 L 59.1,204 L 59.1,195 L 80.2,195 Z"
                                  Fill="{DynamicResource Cheems.Brush.GenderToggle.Female}"
                                  IsHitTestVisible="False" />
                            <Path x:Name="PartMale"
                                  Data="M 228.8,116.2 L 292,40 M 292,40 L 268.9,46.4 M 292,40 L 290,63.9"
                                  Stroke="{DynamicResource Cheems.Brush.GenderToggle.Inactive}"
                                  StrokeThickness="8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  IsHitTestVisible="False" />

                            <!-- 参考截图中的最终 border-box 为 233×88。 -->
                            <Border Canvas.Left="40" Canvas.Top="72"
                                    Width="233" Height="88"
                                    CornerRadius="44"
                                    Background="{DynamicResource Cheems.Brush.GenderToggle.Track}"
                                    BorderBrush="{DynamicResource Cheems.Brush.GenderToggle.Inactive}"
                                    BorderThickness="8" />

                            <!-- ::before：50×50 content + 19.2px border。 -->
                            <Border x:Name="PartBefore"
                                    Canvas.Left="40" Canvas.Top="72"
                                    Width="88.4" Height="88.4" CornerRadius="44.2"
                                    Background="{DynamicResource Cheems.Brush.GenderToggle.Track}"
                                    BorderBrush="{DynamicResource Cheems.Brush.GenderToggle.Male}"
                                    BorderThickness="19.2"
                                    IsHitTestVisible="False" />

                            <!-- ::after：位于 ::before 上层。 -->
                            <Border x:Name="PartAfter"
                                    Canvas.Left="40" Canvas.Top="72"
                                    Width="88.4" Height="88.4" CornerRadius="44.2"
                                    Background="{DynamicResource Cheems.Brush.GenderToggle.FemaleFill}"
                                    BorderBrush="{DynamicResource Cheems.Brush.GenderToggle.Female}"
                                    BorderThickness="19.2"
                                    IsHitTestVisible="False" />
                        </Canvas>
                    </Viewbox>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <!-- translateX(165%)：88.4 × 1.65 = 145.86。 -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartBefore" Storyboard.TargetProperty="(Canvas.Left)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="184.6" KeySpline="0,0.95,0.38,0.98" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartAfter" Storyboard.TargetProperty="(Canvas.Left)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="184.6" KeySpline="0,0.95,0.38,0.98" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartBefore" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                            <SplineColorKeyFrame KeyTime="0:0:0.15" Value="{StaticResource Cheems.Color.GenderToggle.Male}" KeySpline="0.25,0.1,0.25,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartBefore" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)">
                                            <SplineColorKeyFrame KeyTime="0:0:0.15" Value="{StaticResource Cheems.Color.GenderToggle.Female}" KeySpline="0.25,0.1,0.25,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartAfter" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                            <SplineColorKeyFrame KeyTime="0:0:0.15" Value="{StaticResource Cheems.Color.GenderToggle.MaleFill}" KeySpline="0.25,0.1,0.25,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartAfter" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)">
                                            <SplineColorKeyFrame KeyTime="0:0:0.15" Value="{StaticResource Cheems.Color.GenderToggle.Male}" KeySpline="0.25,0.1,0.25,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimation Storyboard.TargetName="PartFemale" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                        To="{StaticResource Cheems.Color.GenderToggle.Inactive}" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="PartMale" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)"
                                                        To="{StaticResource Cheems.Color.GenderToggle.Male}" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartBefore" Storyboard.TargetProperty="(Canvas.Left)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="40" KeySpline="0,0.95,0.38,0.98" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartAfter" Storyboard.TargetProperty="(Canvas.Left)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="40" KeySpline="0,0.95,0.38,0.98" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ColorAnimation Storyboard.TargetName="PartBefore" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource Cheems.Color.GenderToggle.Track}" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="PartBefore" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource Cheems.Color.GenderToggle.Male}" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="PartAfter" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource Cheems.Color.GenderToggle.FemaleFill}" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="PartAfter" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource Cheems.Color.GenderToggle.Female}" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="PartFemale" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="{StaticResource Cheems.Color.GenderToggle.Female}" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="PartMale" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" To="{StaticResource Cheems.Color.GenderToggle.Inactive}" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PartRoot" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="No" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
