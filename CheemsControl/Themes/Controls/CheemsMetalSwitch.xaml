<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <Style TargetType="{x:Type local:CheemsMetalSwitch}">
        <!-- .toggle-border 的 CSS content-box：65 + 2×2 padding + 2×2 border = 73；高度为 20 + 2×1 + 2×2 = 26。 -->
        <Setter Property="Width" Value="73" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsMetalSwitch}">
                    <Grid Width="73" Height="26" Background="Transparent" ClipToBounds="False">
                        <!-- box-shadow: 0 0 0 2px #fbfbfb -->
                        <Border Margin="-2"
                                CornerRadius="15"
                                Background="#FFFBFBFB" />

                        <!-- border、padding 与双层 background。半透明 #dcdcdc 覆盖白色后的终点为 #eeeeee。 -->
                        <Border CornerRadius="13"
                                BorderBrush="#FFF0EBEB"
                                BorderThickness="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FFFFFFFF" />
                                    <GradientStop Offset="1" Color="#FFEEEEEE" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- label: x=border 2 + padding-left 2；y=border 2 + padding-top 1。 -->
                        <Canvas Width="65"
                                Height="20"
                                Margin="4,3,4,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ClipToBounds="False">
                            <Border Width="65" Height="20" CornerRadius="10">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding TrackColor, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border.Background>
                            </Border>

                            <!-- box-shadow: inset 0 0 16px rgba(0,0,0,.3) -->
                            <Canvas Width="65" Height="20" IsHitTestVisible="False">
                                <Canvas.Clip>
                                    <RectangleGeometry Rect="0,0,65,20" RadiusX="10" RadiusY="10" />
                                </Canvas.Clip>
                                <Path Fill="#4D000000">
                                    <Path.Data>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <RectangleGeometry Rect="-40,-40,145,100" />
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <RectangleGeometry Rect="0,0,65,20" RadiusX="10" RadiusY="10" />
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Path.Data>
                                    <Path.Effect>
                                        <BlurEffect Radius="16" />
                                    </Path.Effect>
                                </Path>
                            </Canvas>

                            <!-- .handle：CSS content-box 35×35 + 1px border = 37×37；top -8，left -10→40。 -->
                            <local:CheemsMetalHandleChrome Width="37"
                                                           Height="37"
                                                           Canvas.Top="-8"
                                                           Canvas.Left="{Binding HandleLeft, RelativeSource={RelativeSource TemplatedParent}}"
                                                           IsHitTestVisible="False">
                                <local:CheemsMetalHandleChrome.Effect>
                                    <DropShadowEffect Color="#FF000000"
                                                      Direction="300.9637565"
                                                      ShadowDepth="5.8309518948"
                                                      BlurRadius="10"
                                                      Opacity="0.4" />
                                </local:CheemsMetalHandleChrome.Effect>
                            </local:CheemsMetalHandleChrome>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
