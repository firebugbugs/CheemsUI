<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
      DOM mapping: CheemsPulseDotsLoader=.dots-container; the five code-rendered
      circles map one-to-one to .dot:nth-child(1..5), each with its own shadow layer.
    -->
    <Style TargetType="{x:Type local:CheemsPulseDotsLoader}">
        <!-- 140px is the CSS flex layout width; 10px on each side preserves the
             maximum 10px shadow spread without clipping. -->
        <Setter Property="Width" Value="160" />
        <Setter Property="Height" Value="40" />
        <Setter Property="BaseDotBrush" Value="{DynamicResource Cheems.Brush.PulseDotsLoader.Base}" />
        <Setter Property="ActiveDotBrush" Value="{DynamicResource Cheems.Brush.PulseDotsLoader.Active}" />
        <Setter Property="PulseBrush" Value="{DynamicResource Cheems.Brush.PulseDotsLoader.Pulse}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsPulseDotsLoader}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
