<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <Style TargetType="{x:Type local:CheemsRockerSwitch}">
        <!-- Uiverse 预览环境采用 border-box：150×195 是含 20px padding 的最终外框，内容区为 110×155。 -->
        <Setter Property="Width" Value="150" />
        <Setter Property="Height" Value="195" />
        <Setter Property="IsChecked" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsRockerSwitch}">
                    <Grid Width="150" Height="195" Background="Transparent" ClipToBounds="False">
                        <!-- 两条外阴影分层绘制。 -->
                        <Border CornerRadius="5" Background="#FF000000">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF000000"
                                                  ShadowDepth="0"
                                                  BlurRadius="10"
                                                  Opacity="0.2" />
                            </Border.Effect>
                        </Border>
                        <Border Margin="-2"
                                CornerRadius="7"
                                Background="#FF000000" />
                        <Border CornerRadius="5" Background="#FF000000" />

                        <!-- inset 0 0 2px 15px #47434c；底层黑色同时承担 22px 黑色 inset。 -->
                        <Canvas Width="150" Height="195" IsHitTestVisible="False">
                            <Canvas.Clip>
                                <RectangleGeometry Rect="0,0,150,195" RadiusX="5" RadiusY="5" />
                            </Canvas.Clip>
                            <Path Fill="#FF47434C">
                                <Path.Data>
                                    <CombinedGeometry GeometryCombineMode="Exclude">
                                        <CombinedGeometry.Geometry1>
                                            <RectangleGeometry Rect="0,0,150,195" RadiusX="5" RadiusY="5" />
                                        </CombinedGeometry.Geometry1>
                                        <CombinedGeometry.Geometry2>
                                            <RectangleGeometry Rect="15,15,120,165" />
                                        </CombinedGeometry.Geometry2>
                                    </CombinedGeometry>
                                </Path.Data>
                                <Path.Effect>
                                    <BlurEffect Radius="2" />
                                </Path.Effect>
                            </Path>

                            <!-- inset 0 2px 2px -2px white：只留下顶部细高光。 -->
                            <Border Canvas.Left="2"
                                    Canvas.Top="2"
                                    Width="146"
                                    Height="1"
                                    Background="#CCFFFFFF">
                                <Border.Effect>
                                    <BlurEffect Radius="2" />
                                </Border.Effect>
                            </Border>
                        </Canvas>

                        <!--
                          290×340 视口仍以 700px 相机距离保持 1 个 3D 单位 = 1 个 CSS px，
                          更大的视口只用于容纳 blur 与投影，不改变 150×195 开关盒及 110×155 内容面的比例。
                        -->
                        <Viewport3D Width="290"
                                    Height="340"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True">
                            <Viewport3D.Camera>
                                <PerspectiveCamera Position="0,0,700"
                                                   LookDirection="0,0,-1"
                                                   UpDirection="0,1,0"
                                                   FieldOfView="27.300711" />
                            </Viewport3D.Camera>

                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <AmbientLight Color="#FFFFFFFF" />
                                </ModelVisual3D.Content>
                            </ModelVisual3D>

                            <ModelVisual3D>
                                <ModelVisual3D.Transform>
                                    <Transform3DGroup>
                                        <!-- transform-origin: center center -20px -->
                                        <RotateTransform3D CenterX="0" CenterY="0" CenterZ="-20">
                                            <RotateTransform3D.Rotation>
                                                <AxisAngleRotation3D x:Name="PART_RockerRotation"
                                                                     Axis="1,0,0"
                                                                     Angle="-25" />
                                            </RotateTransform3D.Rotation>
                                        </RotateTransform3D>
                                        <!-- transform: translateZ(20px) rotateX(...) -->
                                        <TranslateTransform3D OffsetZ="20" />
                                    </Transform3DGroup>
                                </ModelVisual3D.Transform>
                                <ModelVisual3D.Children>
                                    <!-- checked box-shadow: 0 -10px 20px #ff1818 -->
                                    <Viewport2DVisual3D>
                                        <Viewport2DVisual3D.Geometry>
                                            <MeshGeometry3D Positions="-85,-117.5,-0.2 85,-117.5,-0.2 85,117.5,-0.2 -85,117.5,-0.2"
                                                            TextureCoordinates="0,1 1,1 1,0 0,0"
                                                            TriangleIndices="0,1,2 0,2,3" />
                                        </Viewport2DVisual3D.Geometry>
                                        <Viewport2DVisual3D.Material>
                                            <DiffuseMaterial Brush="White" Viewport2DVisual3D.IsVisualHostMaterial="True" />
                                        </Viewport2DVisual3D.Material>
                                        <Viewport2DVisual3D.Visual>
                                            <Grid x:Name="PART_Glow"
                                                  Width="170"
                                                  Height="235"
                                                  Opacity="0">
                                                <Border Width="110"
                                                        Height="155"
                                                        Background="#FFFF1818"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform Y="-10" />
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <BlurEffect Radius="20" />
                                                    </Border.Effect>
                                                </Border>
                                            </Grid>
                                        </Viewport2DVisual3D.Visual>
                                    </Viewport2DVisual3D>

                                    <!-- ::after 的第二条远投影：0 80px 20px rgba(0,0,0,.5)。 -->
                                    <Viewport2DVisual3D>
                                        <Viewport2DVisual3D.Geometry>
                                            <MeshGeometry3D Positions="-75,-77.5,-60 -75,-77.5,-150 75,-77.5,-150 75,-77.5,-60"
                                                            TextureCoordinates="0,0 0,1 1,1 1,0"
                                                            TriangleIndices="0,1,2 0,2,3" />
                                        </Viewport2DVisual3D.Geometry>
                                        <Viewport2DVisual3D.Material>
                                            <DiffuseMaterial Brush="White" Viewport2DVisual3D.IsVisualHostMaterial="True" />
                                        </Viewport2DVisual3D.Material>
                                        <Viewport2DVisual3D.Visual>
                                            <Grid Width="190" Height="90">
                                                <Border Width="110" Height="50" Background="#80000000">
                                                    <Border.Effect>
                                                        <BlurEffect Radius="20" />
                                                    </Border.Effect>
                                                </Border>
                                            </Grid>
                                        </Viewport2DVisual3D.Visual>
                                    </Viewport2DVisual3D>

                                    <!-- ::after 的第一条投影：0 50px 8px black。 -->
                                    <Viewport2DVisual3D>
                                        <Viewport2DVisual3D.Geometry>
                                            <MeshGeometry3D Positions="-63,-77.5,-42 -63,-77.5,-108 63,-77.5,-108 63,-77.5,-42"
                                                            TextureCoordinates="0,0 0,1 1,1 1,0"
                                                            TriangleIndices="0,1,2 0,2,3" />
                                        </Viewport2DVisual3D.Geometry>
                                        <Viewport2DVisual3D.Material>
                                            <DiffuseMaterial Brush="White" Viewport2DVisual3D.IsVisualHostMaterial="True" />
                                        </Viewport2DVisual3D.Material>
                                        <Viewport2DVisual3D.Visual>
                                            <Grid Width="166" Height="66">
                                                <Border Width="110" Height="50" Background="#FF000000">
                                                    <Border.Effect>
                                                        <BlurEffect Radius="8" />
                                                    </Border.Effect>
                                                </Border>
                                            </Grid>
                                        </Viewport2DVisual3D.Visual>
                                    </Viewport2DVisual3D>

                                    <!-- .button::after：底部 50px 深度面。 -->
                                    <Viewport2DVisual3D>
                                        <Viewport2DVisual3D.Geometry>
                                            <MeshGeometry3D Positions="-55,-77.5,0 -55,-77.5,-50 55,-77.5,-50 55,-77.5,0"
                                                            TextureCoordinates="0,0 0,1 1,1 1,0"
                                                            TriangleIndices="0,1,2 0,2,3" />
                                        </Viewport2DVisual3D.Geometry>
                                        <Viewport2DVisual3D.Material>
                                            <DiffuseMaterial Brush="White" Viewport2DVisual3D.IsVisualHostMaterial="True" />
                                        </Viewport2DVisual3D.Material>
                                        <Viewport2DVisual3D.Visual>
                                            <Grid Width="110" Height="50">
                                                <Grid.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#FF650000" />
                                                        <GradientStop Offset="1" Color="#FF320000" />
                                                    </LinearGradientBrush>
                                                </Grid.Background>
                                            </Grid>
                                        </Viewport2DVisual3D.Visual>
                                    </Viewport2DVisual3D>

                                    <!-- .button::before：顶部 50px 深度面。 -->
                                    <Viewport2DVisual3D>
                                        <Viewport2DVisual3D.Geometry>
                                            <MeshGeometry3D Positions="-55,77.5,0 55,77.5,0 55,77.5,-50 -55,77.5,-50"
                                                            TextureCoordinates="0,0 1,0 1,1 0,1"
                                                            TriangleIndices="0,1,2 0,2,3" />
                                        </Viewport2DVisual3D.Geometry>
                                        <Viewport2DVisual3D.Material>
                                            <DiffuseMaterial Brush="White" Viewport2DVisual3D.IsVisualHostMaterial="True" />
                                        </Viewport2DVisual3D.Material>
                                        <Viewport2DVisual3D.Visual>
                                            <Grid Width="110" Height="50" Background="#FFB10000">
                                                <Border Width="106.7" Height="48.5">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Offset="0.10" Color="#CCFFFFFF" />
                                                            <GradientStop Offset="0.30" Color="#4DFFFFFF" />
                                                            <GradientStop Offset="0.75" Color="#FF650000" />
                                                            <GradientStop Offset="1.00" Color="#FF320000" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Viewport2DVisual3D.Visual>
                                    </Viewport2DVisual3D>

                                    <!-- .button 正面。 -->
                                    <Viewport2DVisual3D>
                                        <Viewport2DVisual3D.Geometry>
                                            <MeshGeometry3D Positions="-55,-77.5,0 55,-77.5,0 55,77.5,0 -55,77.5,0"
                                                            TextureCoordinates="0,1 1,1 1,0 0,0"
                                                            TriangleIndices="0,1,2 0,2,3" />
                                        </Viewport2DVisual3D.Geometry>
                                        <Viewport2DVisual3D.Material>
                                            <DiffuseMaterial Brush="White" Viewport2DVisual3D.IsVisualHostMaterial="True" />
                                        </Viewport2DVisual3D.Material>
                                        <Viewport2DVisual3D.Visual>
                                            <Grid Width="110" Height="155">
                                                <Grid.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#FF980000" />
                                                        <GradientStop Offset="0.30" Color="#FF6F0000" />
                                                        <GradientStop Offset="0.70" Color="#FF6F0000" />
                                                        <GradientStop Offset="1" Color="#FF980000" />
                                                    </LinearGradientBrush>
                                                </Grid.Background>

                                                <!-- .light -->
                                                <Border x:Name="PART_Light" Opacity="0">
                                                    <Border.Background>
                                                        <RadialGradientBrush RadiusX="0.70710678" RadiusY="0.70710678">
                                                            <GradientStop Offset="0" Color="#FFFFC97E" />
                                                            <GradientStop Offset="0.40" Color="#FFFF1818" />
                                                            <GradientStop Offset="0.70" Color="#00FF1818" />
                                                            <GradientStop Offset="1" Color="#00FF1818" />
                                                        </RadialGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- .dots：10×10 平铺径向渐变。 -->
                                                <Rectangle>
                                                    <Rectangle.Fill>
                                                        <DrawingBrush Viewbox="0,0,10,10"
                                                                      ViewboxUnits="Absolute"
                                                                      Viewport="0,0,10,10"
                                                                      ViewportUnits="Absolute"
                                                                      TileMode="Tile"
                                                                      Stretch="None">
                                                            <DrawingBrush.Drawing>
                                                                <GeometryDrawing Geometry="M0,0 H10 V10 H0 Z">
                                                                    <GeometryDrawing.Brush>
                                                                        <RadialGradientBrush MappingMode="Absolute"
                                                                                             Center="5,5"
                                                                                             GradientOrigin="5,5"
                                                                                             RadiusX="7.0710678"
                                                                                             RadiusY="7.0710678">
                                                                            <GradientStop Offset="0.30" Color="#00000000" />
                                                                            <GradientStop Offset="0.70" Color="#B3650000" />
                                                                            <GradientStop Offset="1" Color="#B3650000" />
                                                                        </RadialGradientBrush>
                                                                    </GeometryDrawing.Brush>
                                                                </GeometryDrawing>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>

                                                <!-- .characters：上方 5%×20% 竖线和下方 33%×25% 圆环。 -->
                                                <Canvas IsHitTestVisible="False">
                                                    <Rectangle Canvas.Left="52.25"
                                                               Canvas.Top="15.5"
                                                               Width="5.5"
                                                               Height="31"
                                                               Fill="#FFFFFFFF" />
                                                    <Rectangle Canvas.Left="36.85"
                                                               Canvas.Top="104.625"
                                                               Width="36.3"
                                                               Height="38.75">
                                                        <Rectangle.Fill>
                                                            <RadialGradientBrush MappingMode="Absolute"
                                                                                 Center="18.15,19.375"
                                                                                 GradientOrigin="18.15,19.375"
                                                                                 RadiusX="27.5"
                                                                                 RadiusY="27.5">
                                                                <GradientStop Offset="0.50" Color="#00FFFFFF" />
                                                                <GradientStop Offset="0.52" Color="#FFFFFFFF" />
                                                                <GradientStop Offset="0.70" Color="#FFFFFFFF" />
                                                                <GradientStop Offset="0.72" Color="#00FFFFFF" />
                                                                <GradientStop Offset="1" Color="#00FFFFFF" />
                                                            </RadialGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Canvas>

                                                <!-- .shine：两张 97%×97% 的 no-repeat 线性渐变叠加。 -->
                                                <Grid x:Name="PART_Shine"
                                                      Width="106.7"
                                                      Height="150.35"
                                                      Opacity="0.3">
                                                    <Border>
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Offset="0" Color="#80FFFFFF" />
                                                                <GradientStop Offset="0.50" Color="#00FFFFFF" />
                                                                <GradientStop Offset="0.80" Color="#00FFFFFF" />
                                                                <GradientStop Offset="1" Color="#80FFFFFF" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Border>
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Offset="0" Color="#FFFFFFFF" />
                                                                <GradientStop Offset="0.03" Color="#00FFFFFF" />
                                                                <GradientStop Offset="1" Color="#00FFFFFF" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>

                                                <!-- .shadow -->
                                                <Border x:Name="PART_Shadow" Opacity="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Offset="0.70" Color="#00000000" />
                                                            <GradientStop Offset="1" Color="#CC000000" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Viewport2DVisual3D.Visual>
                                    </Viewport2DVisual3D>
                                </ModelVisual3D.Children>
                            </ModelVisual3D>
                        </Viewport3D>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
