<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CheemsControl">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type local:CheemsSubscribeButton}">
        <Setter Property="Padding" Value="24,10" /><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Cheems.Brush.SubscribeButton.Gold}" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cheems.Brush.SubscribeButton.Gold}" /><Setter Property="BorderThickness" Value="2" />
        <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:CheemsSubscribeButton}">
            <Grid x:Name="PartShadow"><Grid.Effect><DropShadowEffect Color="{StaticResource Cheems.Color.SubscribeButton.Gold}" ShadowDepth="0" BlurRadius="20" Opacity="0" /></Grid.Effect>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="34" ClipToBounds="True">
                    <Grid><Ellipse x:Name="PartFill" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource Cheems.Brush.SubscribeButton.Gold}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" /></Grid>
                </Border>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
