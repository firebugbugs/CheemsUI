<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
      DOM 一一对应：
      PartRoot=.typewriter；PartSlide=.slide；PartSlideTool=.slide i；
      PartPaper=.paper；PartKeyboard=.keyboard；PartKey1..12=.keyboard::after 的 12 个 box-shadow。
      原 DOM 没有交互状态；全部动画共用 3 秒周期，由控件代码按原关键帧和缓动逐帧求值。
    -->
    <Style TargetType="{x:Type local:CheemsTypewriterLoader}">
        <Setter Property="Width" Value="136" />
        <Setter Property="Height" Value="94" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsTypewriterLoader}">
                    <!-- 136×94 是完整动画包围盒；CSS 根布局本体仍保持 120×66。 -->
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="136" Height="94">
                            <Canvas x:Name="PartRoot" Width="128" Height="66"
                                    Canvas.Left="8" Canvas.Top="26">
                                <!-- .slide：margin-left:14px；translateX 由代码按 slide05 设置。 -->
                                <Canvas x:Name="PartSlide" Width="92" Height="20"
                                        Canvas.Left="14" Canvas.Top="0">
                                    <Border Width="92" Height="20" CornerRadius="3">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Offset="0" Color="{StaticResource Cheems.Color.TypewriterLoader.Blue}" />
                                                <GradientStop Offset="1" Color="{StaticResource Cheems.Color.TypewriterLoader.BlueDark}" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- .slide::before -->
                                    <Border Width="2" Height="8" Canvas.Left="92" Canvas.Top="6"
                                            Background="{DynamicResource Cheems.Brush.TypewriterLoader.Tool}" />
                                    <!-- .slide::after -->
                                    <Border Width="6" Height="14" Canvas.Left="94" Canvas.Top="3"
                                            CornerRadius="3"
                                            Background="{DynamicResource Cheems.Brush.TypewriterLoader.Tool}" />

                                    <!-- .slide i 与 .slide i::before -->
                                    <Canvas x:Name="PartSlideTool" Width="6" Height="4"
                                            Canvas.Left="-6" Canvas.Top="4">
                                        <Border Width="6" Height="4"
                                                Background="{DynamicResource Cheems.Brush.TypewriterLoader.Tool}" />
                                        <Border Width="4" Height="14" Canvas.Left="-4" Canvas.Top="-2"
                                                CornerRadius="2"
                                                Background="{DynamicResource Cheems.Brush.TypewriterLoader.Tool}" />
                                    </Canvas>
                                </Canvas>

                                <!-- .paper：left:24、top:-26、40×46；translateY 由 paper05 设置。 -->
                                <Border x:Name="PartPaper" Width="40" Height="46"
                                        Canvas.Left="24" Canvas.Top="-26"
                                        CornerRadius="5"
                                        Background="{DynamicResource Cheems.Brush.TypewriterLoader.Paper}">
                                    <Canvas Width="40" Height="46">
                                        <!-- .paper::before 及其三个 box-shadow；scaleY(.8) 后高 3.2px。 -->
                                        <Border Width="28" Height="3.2" Canvas.Left="6" Canvas.Top="7.4"
                                                CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Text}" />
                                        <Border Width="28" Height="3.2" Canvas.Left="6" Canvas.Top="19.4"
                                                CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Text}" />
                                        <Border Width="28" Height="3.2" Canvas.Left="6" Canvas.Top="31.4"
                                                CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Text}" />
                                        <Border Width="28" Height="3.2" Canvas.Left="6" Canvas.Top="43.4"
                                                CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Text}" />
                                    </Canvas>
                                </Border>

                                <!-- .keyboard：正常流中位于 slide 后，margin-top:-10 => top:10。 -->
                                <Canvas x:Name="PartKeyboard" Width="120" Height="56"
                                        Canvas.Left="0" Canvas.Top="10" Panel.ZIndex="1">
                                    <!--
                                      .keyboard::before 的 perspective(10px) rotateX(2deg)、origin 50% 100%。
                                      路径是该 120×56、圆角 7px 平面投影后的约 10,9 → 120,56 梯形。
                                    -->
                                    <Path Stretch="None">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure StartPoint="17,9" IsClosed="True">
                                                    <LineSegment Point="103,9" />
                                                    <QuadraticBezierSegment Point1="109,9" Point2="110.5,15" />
                                                    <LineSegment Point="119.5,49" />
                                                    <QuadraticBezierSegment Point1="121,56" Point2="113,56" />
                                                    <LineSegment Point="7,56" />
                                                    <QuadraticBezierSegment Point1="-1,56" Point2="0.5,49" />
                                                    <LineSegment Point="9.5,15" />
                                                    <QuadraticBezierSegment Point1="11,9" Point2="17,9" />
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="{StaticResource Cheems.Color.TypewriterLoader.Blue}" />
                                                <GradientStop Offset="1" Color="{StaticResource Cheems.Color.TypewriterLoader.BlueDark}" />
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>

                                    <!-- .keyboard::after 的第一行六个 box-shadow。 -->
                                    <Border x:Name="PartKey1" Width="11" Height="4" Canvas.Left="17" Canvas.Top="25"
                                            CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Key}" />
                                    <Border x:Name="PartKey2" Width="11" Height="4" Canvas.Left="32" Canvas.Top="25"
                                            CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Key}" />
                                    <Border x:Name="PartKey3" Width="11" Height="4" Canvas.Left="47" Canvas.Top="25"
                                            CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Key}" />
                                    <Border x:Name="PartKey4" Width="11" Height="4" Canvas.Left="62" Canvas.Top="25"
                                            CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Key}" />
                                    <Border x:Name="PartKey5" Width="11" Height="4" Canvas.Left="77" Canvas.Top="25"
                                            CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Key}" />
                                    <Border x:Name="PartKey6" Width="11" Height="4" Canvas.Left="92" Canvas.Top="25"
                                            CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Key}" />

                                    <!-- 第二行六个 box-shadow；保留源码的重叠间距。 -->
                                    <Border x:Name="PartKey7" Width="11" Height="4" Canvas.Left="24" Canvas.Top="35"
                                            CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Key}" />
                                    <Border x:Name="PartKey8" Width="11" Height="4" Canvas.Left="39" Canvas.Top="35"
                                            CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Key}" />
                                    <Border x:Name="PartKey9" Width="11" Height="4" Canvas.Left="54" Canvas.Top="35"
                                            CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Key}" />
                                    <Border x:Name="PartKey10" Width="11" Height="4" Canvas.Left="62" Canvas.Top="35"
                                            CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Key}" />
                                    <Border x:Name="PartKey11" Width="11" Height="4" Canvas.Left="70" Canvas.Top="35"
                                            CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Key}" />
                                    <Border x:Name="PartKey12" Width="11" Height="4" Canvas.Left="85" Canvas.Top="35"
                                            CornerRadius="2" Background="{DynamicResource Cheems.Brush.TypewriterLoader.Key}" />
                                </Canvas>
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
