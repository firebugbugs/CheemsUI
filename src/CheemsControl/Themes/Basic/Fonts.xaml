<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      字体族统一定义处：全库唯一允许出现字体 pack URI 的地方（CONVENTIONS F2）。
      当前暂用系统字体；向 Resources/Fonts/ 放入字体后改为内嵌引用，例如：
      /CheemsControl;component/Resources/Fonts/MiSans-Regular.ttf#MiSans
      新增字体须注释「字体名 | 来源 | 授权」（CONVENTIONS F5）。
    -->

    <FontFamily x:Key="Cheems.FontFamily.Default">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Cheems.FontFamily.Mono">Cascadia Mono, Consolas</FontFamily>
    <!-- 图标字体：资源里暂用系统图标字体回退，引入图标字体后在此替换 -->
    <FontFamily x:Key="Cheems.FontFamily.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- 字号阶梯 -->
    <sys:Double x:Key="Cheems.FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="Cheems.FontSize.Body">14</sys:Double>
    <sys:Double x:Key="Cheems.FontSize.SubTitle">17</sys:Double>
    <sys:Double x:Key="Cheems.FontSize.Title">20</sys:Double>
    <sys:Double x:Key="Cheems.FontSize.Large">28</sys:Double>
</ResourceDictionary>
