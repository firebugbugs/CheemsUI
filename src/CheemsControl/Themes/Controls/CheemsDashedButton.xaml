<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <!-- 字典自包含（CONVENTIONS R3.9）：DropShadowEffect.Color 为 StaticResource 引 L1，自身合并 Colors -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
      虚线按钮：移植自 Uiverse(Praashoo7) 的 CSS 按钮。
      结构（分层，避免文字被投影污染）：
      投影载体 Border（仅提供米色剪影给 DropShadowEffect）
      + 视觉层（4px 底色光环 Border + 虚线描边 Rectangle + 内容）。
      按下（CSS :active + transition .1s）：整体位移 2px、投影 BlurRadius 5→3 / ShadowDepth 2→1.5。
    -->
    <Style TargetType="{x:Type local:CheemsDashedButton}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Cheems.Brush.DashedButton.Foreground}" />
        <Setter Property="FontFamily" Value="{DynamicResource Cheems.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Cheems.FontSize.Body}" />
        <Setter Property="Padding" Value="48,16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsDashedButton}">
                    <Grid x:Name="PartRoot">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>

                        <!-- 投影载体：只给阴影提供米色剪影，不承载内容 -->
                        <Border x:Name="PartShadowHost"
                                Margin="8"
                                CornerRadius="19"
                                Background="{DynamicResource Cheems.Brush.DashedButton.Background}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5"
                                                  ShadowDepth="2"
                                                  Direction="315"
                                                  Color="{StaticResource Cheems.Color.Shadow}" />
                            </Border.Effect>
                        </Border>

                        <!-- 视觉层：4px 底色光环 + 圆角主体 + 虚线描边 + 内容 -->
                        <Border Margin="8"
                                Padding="4"
                                CornerRadius="19">
                            <Border x:Name="PartBody"
                                    CornerRadius="15"
                                    Background="{DynamicResource Cheems.Brush.DashedButton.Background}">
                                <Grid>
                                    <Rectangle Stroke="{DynamicResource Cheems.Brush.DashedButton.Border}"
                                               StrokeThickness="2"
                                               StrokeDashArray="3 2"
                                               RadiusX="13"
                                               RadiusY="13" />
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"
                                                      RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PartRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="2" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="PartRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="2" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="PartShadowHost"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                         To="3" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="PartShadowHost"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                         To="1.5" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PartRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="PartRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="PartShadowHost"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                         To="5" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="PartShadowHost"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                         To="2" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
