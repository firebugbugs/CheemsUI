<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Cheems.DominoLoader.Domino" TargetType="Border">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10,50,10,50" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="1" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:CheemsDominoLoader}">
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="200" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsDominoLoader}">
                    <Grid Width="200" Height="200">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="PartDomino1" Style="{StaticResource Cheems.DominoLoader.Domino}" Background="{DynamicResource Cheems.Brush.DominoLoader.One}" />
                            <Border x:Name="PartDomino2" Style="{StaticResource Cheems.DominoLoader.Domino}" Background="{DynamicResource Cheems.Brush.DominoLoader.Two}" />
                            <Border x:Name="PartDomino3" Style="{StaticResource Cheems.DominoLoader.Domino}" Background="{DynamicResource Cheems.Brush.DominoLoader.Three}" />
                            <Border x:Name="PartDomino4" Style="{StaticResource Cheems.DominoLoader.Domino}" Background="{DynamicResource Cheems.Brush.DominoLoader.Four}" />
                            <Border x:Name="PartDomino5" Style="{StaticResource Cheems.DominoLoader.Domino}" Background="{DynamicResource Cheems.Brush.DominoLoader.Five}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
