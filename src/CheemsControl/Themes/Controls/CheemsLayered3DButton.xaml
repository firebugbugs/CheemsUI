<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CheemsControl">
    <Style TargetType="{x:Type local:CheemsLayered3DButton}">
        <Setter Property="Width" Value="190"/><Setter Property="Height" Value="145"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="25"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:CheemsLayered3DButton}">
            <Canvas Width="190" Height="145" Background="Transparent">
                <Grid Width="100" Height="52" Canvas.Left="35" Canvas.Top="65" RenderTransformOrigin=".5,.5">
                    <Grid.RenderTransform><TransformGroup><SkewTransform AngleX="25"/><RotateTransform Angle="-25"/></TransformGroup></Grid.RenderTransform>
                    <!-- ::before — bottom face: bottom:-10px → y=32, left:-5px, 100×10, skewX(-41deg) around center -->
                    <Rectangle Width="100" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,32,0,0" Fill="#2A2A2A" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><SkewTransform AngleX="-41"/></Rectangle.RenderTransform></Rectangle>
                    <!-- ::after — left face: top:5px, left:-9px, 9×32, skewY(-49deg) around center -->
                    <Rectangle Width="9" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-9,5,0,0" Fill="#2A2A2A" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><SkewTransform AngleY="-49"/></Rectangle.RenderTransform></Rectangle>
                    <Border x:Name="PartLayer1" Width="100" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Border x:Name="PartLayer2" Width="100" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Border x:Name="PartLayer3" Width="100" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Border x:Name="PartLayer4" Width="100" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Border x:Name="PartLayer5" Width="100" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                </Grid>
            </Canvas>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
