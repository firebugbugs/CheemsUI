<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Cheems.PixelHandButton.FocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Rectangle Margin="-4"
                               Stroke="{DynamicResource Cheems.Brush.PixelHandButton.Stone800}"
                               StrokeThickness="2"
                               StrokeDashArray="2,2"
                               RadiusX="5" RadiusY="5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:CheemsPixelHandButton}">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cheems.PixelHandButton.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsPixelHandButton}">
                    <Canvas Width="64" Height="64" Background="Transparent">
                        <!-- span:nth-child(5): rear spring/pusher and its 7px zero-blur shadow. -->
                        <Border x:Name="PartRearShadow"
                                Canvas.Left="31" Canvas.Top="8"
                                Width="16" Height="48"
                                Background="{DynamicResource Cheems.Brush.PixelHandButton.Stone800}"
                                CornerRadius="12">
                            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        </Border>
                        <Border x:Name="PartRear"
                                Canvas.Left="24" Canvas.Top="8"
                                Width="16" Height="48"
                                Background="{DynamicResource Cheems.Brush.PixelHandButton.Yellow400}"
                                BorderBrush="{DynamicResource Cheems.Brush.PixelHandButton.Stone800}"
                                BorderThickness="2" CornerRadius="12">
                            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        </Border>
                        <Border x:Name="PartRearHighlight"
                                Canvas.Left="26" Canvas.Top="10"
                                Width="12" Height="2"
                                Background="{DynamicResource Cheems.Brush.PixelHandButton.Yellow300}">
                            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        </Border>
                        <Border x:Name="PartRearShade"
                                Canvas.Left="26" Canvas.Top="52"
                                Width="12" Height="2"
                                Background="{DynamicResource Cheems.Brush.PixelHandButton.Yellow500}">
                            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        </Border>

                        <!-- button: 4rem square, 2px border, .25rem radius. -->
                        <Border x:Name="PartButtonBase"
                                Width="64" Height="64"
                                Background="{DynamicResource Cheems.Brush.PixelHandButton.Yellow400}"
                                BorderBrush="{DynamicResource Cheems.Brush.PixelHandButton.Stone800}"
                                BorderThickness="2" CornerRadius="4" />
                        <Border x:Name="PartHoverBase"
                                Width="64" Height="64" Opacity="0"
                                Background="{DynamicResource Cheems.Brush.PixelHandButton.Yellow300}"
                                BorderBrush="{DynamicResource Cheems.Brush.PixelHandButton.Stone800}"
                                BorderThickness="2" CornerRadius="4" />

                        <!-- span:nth-child(2): inset yellow face with a 2px translucent lower edge. -->
                        <Border Canvas.Left="3" Canvas.Top="3"
                                Width="58" Height="58"
                                Background="{DynamicResource Cheems.Brush.PixelHandButton.Yellow400}"
                                BorderBrush="{DynamicResource Cheems.Brush.PixelHandButton.Black25}"
                                BorderThickness="0,0,0,2" />

                        <!-- span:nth-child(2)::before: two staggered 8px radial-dot tiles. -->
                        <Rectangle x:Name="PartDots"
                                   Canvas.Left="3" Canvas.Top="3"
                                   Width="58" Height="56" Opacity="0.5">
                            <Rectangle.Fill>
                                <DrawingBrush Viewport="0,0,8,8"
                                              ViewportUnits="Absolute"
                                              Viewbox="0,0,8,8"
                                              ViewboxUnits="Absolute"
                                              TileMode="Tile" Stretch="None">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#CCFFFFFF">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="0,0" RadiusX="1.15" RadiusY="1.15" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#FFFFFFFF">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="4,4" RadiusX="1.15" RadiusY="1.15" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- span:nth-child(3)::before: four 6px corner fasteners. -->
                        <Border Canvas.Left="4" Canvas.Top="4" Width="6" Height="6"
                                Background="{DynamicResource Cheems.Brush.PixelHandButton.Stone800}" CornerRadius="2" />
                        <Border Canvas.Left="54" Canvas.Top="4" Width="6" Height="6"
                                Background="{DynamicResource Cheems.Brush.PixelHandButton.Stone800}" CornerRadius="2" />
                        <Border Canvas.Left="4" Canvas.Top="54" Width="6" Height="6"
                                Background="{DynamicResource Cheems.Brush.PixelHandButton.Stone800}" CornerRadius="2" />
                        <Border Canvas.Left="54" Canvas.Top="54" Width="6" Height="6"
                                Background="{DynamicResource Cheems.Brush.PixelHandButton.Stone800}" CornerRadius="2" />

                        <!-- span:nth-child(4)::after: one 4px pixel plus the exact box-shadow offsets. -->
                        <Path x:Name="PartPixelHand"
                              Fill="{DynamicResource Cheems.Brush.PixelHandButton.Stone800}"
                              Data="M16,14 h4 v4 h-4 z
                                    M28,46 h4 v4 h-4 z M32,46 h4 v4 h-4 z
                                    M28,42 h4 v4 h-4 z M32,42 h4 v4 h-4 z
                                    M28,34 h4 v4 h-4 z M32,34 h4 v4 h-4 z
                                    M28,30 h4 v4 h-4 z M32,30 h4 v4 h-4 z
                                    M32,26 h4 v4 h-4 z M40,26 h4 v4 h-4 z M36,26 h4 v4 h-4 z
                                    M36,10 h4 v4 h-4 z M40,14 h4 v4 h-4 z
                                    M36,22 h4 v4 h-4 z M40,22 h4 v4 h-4 z
                                    M36,18 h4 v4 h-4 z M40,18 h4 v4 h-4 z
                                    M36,14 h4 v4 h-4 z
                                    M32,10 h4 v4 h-4 z M28,10 h4 v4 h-4 z
                                    M24,10 h4 v4 h-4 z M20,10 h4 v4 h-4 z
                                    M20,14 h4 v4 h-4 z M16,18 h4 v4 h-4 z
                                    M16,22 h4 v4 h-4 z M20,18 h4 v4 h-4 z M20,22 h4 v4 h-4 z">
                            <Path.Effect>
                                <DropShadowEffect x:Name="PartHandShadow"
                                                  Color="#000000" Opacity="0.2"
                                                  BlurRadius="0" Direction="315"
                                                  ShadowDepth="5.656854" />
                            </Path.Effect>
                        </Path>

                        <!-- :active outline; focus-visible is supplied by FocusVisualStyle. -->
                        <Border x:Name="PartPressedOutline"
                                Canvas.Left="-4" Canvas.Top="-4"
                                Width="72" Height="72" Opacity="0"
                                BorderBrush="{DynamicResource Cheems.Brush.PixelHandButton.Stone800}"
                                BorderThickness="2" CornerRadius="6" />
                    </Canvas>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PartHoverBase"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PartHandShadow"
                                                         Storyboard.TargetProperty="ShadowDepth"
                                                         To="2.828427" Duration="0:0:0.075" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PartHoverBase"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PartHandShadow"
                                                         Storyboard.TargetProperty="ShadowDepth"
                                                         To="5.656854" Duration="0:0:0.075" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PartPressedOutline" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
