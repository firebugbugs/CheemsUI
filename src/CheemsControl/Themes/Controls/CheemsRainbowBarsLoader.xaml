<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Cheems.RainbowBarsLoader.Bar" TargetType="Border">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="5" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style TargetType="{x:Type local:CheemsRainbowBarsLoader}">
        <!-- 原始 87×50 盒外为 10px box-shadow 预留透明安全区。 -->
        <Setter Property="Width" Value="107" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsRainbowBarsLoader}">
                    <StackPanel Width="87" Height="50" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="PartBar1" Style="{StaticResource Cheems.RainbowBarsLoader.Bar}" Background="{DynamicResource Cheems.Brush.RainbowBarsLoader.Red}" Margin="0,0,3,0"><Border.Effect><DropShadowEffect Color="{StaticResource Cheems.Color.RainbowBarsLoader.Red}" Direction="315" ShadowDepth="1.414" BlurRadius="10" /></Border.Effect></Border>
                        <Border x:Name="PartBar2" Style="{StaticResource Cheems.RainbowBarsLoader.Bar}" Background="{DynamicResource Cheems.Brush.RainbowBarsLoader.Orange}" Margin="0,0,3,0"><Border.Effect><DropShadowEffect Color="{StaticResource Cheems.Color.RainbowBarsLoader.Orange}" Direction="315" ShadowDepth="1.414" BlurRadius="10" /></Border.Effect></Border>
                        <Border x:Name="PartBar3" Style="{StaticResource Cheems.RainbowBarsLoader.Bar}" Background="{DynamicResource Cheems.Brush.RainbowBarsLoader.Yellow}" Margin="0,0,3,0"><Border.Effect><DropShadowEffect Color="{StaticResource Cheems.Color.RainbowBarsLoader.Yellow}" Direction="315" ShadowDepth="1.414" BlurRadius="10" /></Border.Effect></Border>
                        <Border x:Name="PartBar4" Style="{StaticResource Cheems.RainbowBarsLoader.Bar}" Background="{DynamicResource Cheems.Brush.RainbowBarsLoader.Green}" Margin="0,0,3,0"><Border.Effect><DropShadowEffect Color="{StaticResource Cheems.Color.RainbowBarsLoader.Green}" Direction="315" ShadowDepth="1.414" BlurRadius="10" /></Border.Effect></Border>
                        <Border x:Name="PartBar5" Style="{StaticResource Cheems.RainbowBarsLoader.Bar}" Background="{DynamicResource Cheems.Brush.RainbowBarsLoader.Blue}" Margin="0,0,3,0"><Border.Effect><DropShadowEffect Color="{StaticResource Cheems.Color.RainbowBarsLoader.Blue}" Direction="315" ShadowDepth="1.414" BlurRadius="10" /></Border.Effect></Border>
                        <Border x:Name="PartBar6" Style="{StaticResource Cheems.RainbowBarsLoader.Bar}" Background="{DynamicResource Cheems.Brush.RainbowBarsLoader.Violet}"><Border.Effect><DropShadowEffect Color="{StaticResource Cheems.Color.RainbowBarsLoader.Violet}" Direction="315" ShadowDepth="1.414" BlurRadius="10" /></Border.Effect></Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
