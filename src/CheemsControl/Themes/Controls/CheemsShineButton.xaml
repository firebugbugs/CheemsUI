<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsControl">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsControl;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsShineButton}">
        <Setter Property="Padding" Value="35,17" />
        <Setter Property="Background" Value="{DynamicResource Cheems.Brush.ShineButton.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Cheems.Brush.ShineButton.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cheems.Brush.ShineButton.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsShineButton}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            ClipToBounds="True">
                        <Grid>
                            <Canvas ClipToBounds="True">
                                <Rectangle x:Name="PartShine"
                                           Width="50" Height="155"
                                           Canvas.Left="-75" Canvas.Top="-50"
                                           Fill="{DynamicResource Cheems.Brush.ShineButton.Shine}"
                                           Opacity="0.4" />
                            </Canvas>
                            <ContentPresenter x:Name="PartContent"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
