<Application x:Class="CheemsUI.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CheemsUI.App">
    <Application.Resources>
        <!-- 合并类库资源入口（规矩 M7）：Demo 界面统一使用 Cheems.* 语义键 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CheemsUI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Cheems.App.Converter.BooleanToVisibility" />

            <!--
                统一移除 WPF 默认的虚线焦点装饰器。
                这里仅替换系统 FocusVisualStyle，不禁用键盘焦点、Tab 导航，
                也不会覆盖控件模板内自行设计的聚焦颜色或动画。
            -->
            <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Control}" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 大、小展示器共用的极简源码按钮：只呈现文字，不绘制背景、边框或状态框。 -->
            <Style x:Key="Cheems.App.Style.CodeButton" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="{DynamicResource Cheems.Brush.Text.Primary}" />
                <Setter Property="FontFamily" Value="{DynamicResource Cheems.FontFamily.Mono}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="PartGlyphRoot"
                                  MinWidth="30" MinHeight="24"
                                  Margin="{TemplateBinding Padding}"
                                  Opacity="0.45"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>

                                <TextBlock x:Name="PartCodeGlyph"
                                           Text="&lt;/&gt;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}" />

                                <Path x:Name="PartCheckGlyph"
                                      Width="16" Height="16"
                                      Data="M 1.5,8.5 L 6,13 L 14.5,3"
                                      Stretch="None"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Opacity="0"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="PartCheckScale" ScaleX="0.55" ScaleY="0.55" />
                                            <RotateTransform x:Name="PartCheckRotation" Angle="-18" />
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>

                                <TextBlock x:Name="PartFailureGlyph"
                                           Text="×" FontSize="19"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           Opacity="0">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="PartFailureTranslate" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PartGlyphRoot"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.14" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PartGlyphRoot"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.45" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="PartGlyphRoot" Property="RenderTransform">
                                        <Setter.Value><ScaleTransform ScaleX="0.88" ScaleY="0.88" /></Setter.Value>
                                    </Setter>
                                </Trigger>

                                <Trigger Property="Tag" Value="Copying">
                                    <Setter TargetName="PartCodeGlyph" Property="Opacity" Value="0.35" />
                                </Trigger>

                                <Trigger Property="Tag" Value="Success">
                                    <Setter TargetName="PartCodeGlyph" Property="Opacity" Value="0" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                            <Storyboard>
                                                <!-- 覆盖上一次成功态退出动画遗留的 HoldEnd，确保图标不会与勾号重叠。 -->
                                                <DoubleAnimation Storyboard.TargetName="PartCodeGlyph"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0" />
                                                <DoubleAnimation Storyboard.TargetName="PartCheckGlyph"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="PartCheckScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 From="0.55" To="1" Duration="0:0:0.24">
                                                    <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PartCheckScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 From="0.55" To="1" Duration="0:0:0.24">
                                                    <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PartCheckRotation"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="-18" To="0" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PartCheckGlyph"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="PartCodeGlyph"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" BeginTime="0:0:0.06" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="Tag" Value="Failure">
                                    <Setter TargetName="PartCodeGlyph" Property="Opacity" Value="0" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                            <Storyboard>
                                                <!-- 同上：失败状态也必须取代遗留的源码图标动画。 -->
                                                <DoubleAnimation Storyboard.TargetName="PartCodeGlyph"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0" />
                                                <DoubleAnimation Storyboard.TargetName="PartFailureGlyph"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartFailureTranslate"
                                                                               Storyboard.TargetProperty="X">
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="-2" />
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.10" Value="2" />
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="0" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PartGlyphRoot" Property="Opacity" Value="0.25" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
