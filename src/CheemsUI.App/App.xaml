<Application x:Class="CheemsUI.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CheemsUI.App">
    <Application.Resources>
        <!-- 合并类库资源入口（规矩 M7）：Demo 界面统一使用 Cheems.* 语义键 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CheemsUI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Cheems.App.Converter.BooleanToVisibility" />

            <!--
                统一移除 WPF 默认的虚线焦点装饰器。
                这里仅替换系统 FocusVisualStyle，不禁用键盘焦点、Tab 导航，
                也不会覆盖控件模板内自行设计的聚焦颜色或动画。
            -->
            <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Control}" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 应用级窄滚动条：保留 ScrollViewer 的原生滚轮、键盘与拖拽语义，仅替换视觉模板。 -->
            <Style x:Key="Cheems.App.Style.ScrollBar.PageButton" TargetType="{x:Type RepeatButton}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Cheems.App.Style.ScrollBar.Thumb" TargetType="{x:Type Thumb}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border x:Name="PartThumb"
                                    Margin="2"
                                    Background="{DynamicResource Cheems.Brush.Text.Secondary}"
                                    CornerRadius="4"
                                    Opacity="1"
                                    SnapsToDevicePixels="True" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PartThumb" Property="Margin" Value="1" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="PartThumb" Property="Margin" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PartThumb" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ScrollBar}">
                <!-- 默认是纵向；横向尺寸在模板触发器中交换。 -->
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="{TemplateBinding Background}"
                                  SnapsToDevicePixels="True">
                                <Border x:Name="PartTrackBackground"
                                        Margin="4,2"
                                        Background="{DynamicResource Cheems.Brush.Text.Secondary}"
                                        CornerRadius="3"
                                        Opacity="0.08"
                                        IsHitTestVisible="False" />
                                <Track x:Name="PART_Track"
                                       Margin="0"
                                       Orientation="{TemplateBinding Orientation}"
                                       IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton x:Name="PartDecreaseButton"
                                                      Style="{StaticResource Cheems.App.Style.ScrollBar.PageButton}"
                                                      Command="{x:Static ScrollBar.PageUpCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="PartThumb"
                                               MinHeight="36"
                                               MinWidth="0"
                                               Style="{StaticResource Cheems.App.Style.ScrollBar.Thumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton x:Name="PartIncreaseButton"
                                                      Style="{StaticResource Cheems.App.Style.ScrollBar.PageButton}"
                                                      Command="{x:Static ScrollBar.PageDownCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PartTrackBackground" Property="Opacity" Value="0.14" />
                                </Trigger>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="Height" Value="12" />
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                    <Setter TargetName="PartTrackBackground" Property="Margin" Value="2,4" />
                                    <Setter TargetName="PartThumb" Property="MinWidth" Value="36" />
                                    <Setter TargetName="PartThumb" Property="MinHeight" Value="0" />
                                    <Setter TargetName="PartDecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                                    <Setter TargetName="PartIncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PartTrackBackground" Property="Opacity" Value="0.04" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="False">
                        <Setter Property="Opacity" Value="0.36" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.20" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 大、小展示器共用的极简源码按钮：只呈现文字，不绘制背景、边框或状态框。 -->
            <Style x:Key="Cheems.App.Style.CodeButton" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="{DynamicResource Cheems.Brush.Text.Primary}" />
                <Setter Property="FontFamily" Value="{DynamicResource Cheems.FontFamily.Mono}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="PartGlyphRoot"
                                  MinWidth="30" MinHeight="24"
                                  Margin="{TemplateBinding Padding}"
                                  Opacity="0.45"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>

                                <TextBlock x:Name="PartCodeGlyph"
                                           Text="&lt;/&gt;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}" />

                                <Path x:Name="PartCheckGlyph"
                                      Width="16" Height="16"
                                      Data="M 1.5,8.5 L 6,13 L 14.5,3"
                                      Stretch="None"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Opacity="0"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="PartCheckScale" ScaleX="0.55" ScaleY="0.55" />
                                            <RotateTransform x:Name="PartCheckRotation" Angle="-18" />
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>

                                <TextBlock x:Name="PartFailureGlyph"
                                           Text="×" FontSize="19"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           Opacity="0">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="PartFailureTranslate" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PartGlyphRoot"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.14" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PartGlyphRoot"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.45" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="PartGlyphRoot" Property="RenderTransform">
                                        <Setter.Value><ScaleTransform ScaleX="0.88" ScaleY="0.88" /></Setter.Value>
                                    </Setter>
                                </Trigger>

                                <Trigger Property="Tag" Value="Copying">
                                    <Setter TargetName="PartCodeGlyph" Property="Opacity" Value="0.35" />
                                </Trigger>

                                <Trigger Property="Tag" Value="Success">
                                    <Setter TargetName="PartCodeGlyph" Property="Opacity" Value="0" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                            <Storyboard>
                                                <!-- 覆盖上一次成功态退出动画遗留的 HoldEnd，确保图标不会与勾号重叠。 -->
                                                <DoubleAnimation Storyboard.TargetName="PartCodeGlyph"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0" />
                                                <DoubleAnimation Storyboard.TargetName="PartCheckGlyph"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="PartCheckScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 From="0.55" To="1" Duration="0:0:0.24">
                                                    <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PartCheckScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 From="0.55" To="1" Duration="0:0:0.24">
                                                    <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PartCheckRotation"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="-18" To="0" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PartCheckGlyph"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="PartCodeGlyph"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" BeginTime="0:0:0.06" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="Tag" Value="Failure">
                                    <Setter TargetName="PartCodeGlyph" Property="Opacity" Value="0" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                            <Storyboard>
                                                <!-- 同上：失败状态也必须取代遗留的源码图标动画。 -->
                                                <DoubleAnimation Storyboard.TargetName="PartCodeGlyph"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0" />
                                                <DoubleAnimation Storyboard.TargetName="PartFailureGlyph"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartFailureTranslate"
                                                                               Storyboard.TargetProperty="X">
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="-2" />
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.10" Value="2" />
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="0" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PartGlyphRoot" Property="Opacity" Value="0.25" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
