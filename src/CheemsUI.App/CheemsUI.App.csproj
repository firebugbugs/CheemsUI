<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>CheemsUI.App.Program</StartupObject>
    <ApplicationIcon>Assets\Branding\head_portrait_64x64.ico</ApplicationIcon>
    <AssemblyTitle>CheemsUI</AssemblyTitle>
    <Product>CheemsUI</Product>
    <Description>CheemsUI 组件展示</Description>
    <Version>0.0.1</Version>
    <!-- 不把 git 哈希拼进 ProductVersion，保证安装包版本号干净地跟随 <Version> -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    <!-- WebView2 仅承载 Resources/Web 中的本地 Vanta 页面；不请求任何 CDN。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3065.39" />
    <ProjectReference Include="..\CheemsUI\CheemsUI.csproj" />
  </ItemGroup>

  <!-- 示例源码打包（规矩 M4）：Sources/ 下的 txt 自动作为 Resource -->
  <ItemGroup>
    <Resource Include="Sources\**\*.txt" />
    <Resource Include="Assets\Branding\head_portrait.png" />
    <Resource Include="Assets\Branding\head_portrait_64x64.ico" />
  </ItemGroup>

  <!-- 录制光标素材：随构建复制到输出目录，替换 Assets\cursor.png 后重新导出即可换光标 -->
  <ItemGroup>
    <Content Include="Assets\cursor.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\CheemsUI\Resources\Web\VantaBirds\**\*.*"
             Link="Assets\VantaBirds\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\CheemsUI\Resources\Web\VantaClouds\**\*.*"
             Link="Assets\VantaClouds\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\CheemsUI\Resources\Web\VantaCells\**\*.*"
             Link="Assets\VantaCells\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\CheemsUI\Resources\Web\VantaDots\**\*.*"
             Link="Assets\VantaDots\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\CheemsUI\Resources\Web\RisoDither\**\*.*"
             Link="Assets\RisoDither\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
