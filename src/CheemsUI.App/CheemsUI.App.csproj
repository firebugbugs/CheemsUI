<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>CheemsUI.App.Program</StartupObject>
    <Version>0.0.1</Version>
    <!-- 不把 git 哈希拼进 ProductVersion，保证安装包版本号干净地跟随 <Version> -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    <ProjectReference Include="..\CheemsUI\CheemsUI.csproj" />
  </ItemGroup>

  <!-- 示例源码打包（规矩 M4）：Sources/ 下的 txt 自动作为 Resource -->
  <ItemGroup>
    <Resource Include="Sources\**\*.txt" />
  </ItemGroup>

  <!-- 录制光标素材：随构建复制到输出目录，替换 Assets\cursor.png 后重新导出即可换光标 -->
  <ItemGroup>
    <Content Include="Assets\cursor.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
