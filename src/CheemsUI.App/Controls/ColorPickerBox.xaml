<UserControl x:Class="CheemsUI.App.Controls.ColorPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 应用级通用取色器：常驻只显示一个颜色方块，点击后在鼠标旁弹出完整取色面板。
         应用自己的控件与样式统一放在 Controls 目录，不并入 App.xaml。 -->
    <UserControl.Resources>
        <Style x:Key="ColorPicker.SwatchButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PartPreset" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#4D000000" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PartPreset" Property="BorderBrush" Value="{DynamicResource Cheems.Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PartPreset" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorPicker.HexBoxStyle" TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="Invalid">
                    <Setter Property="BorderBrush" Value="#D64545" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="PartSwatchButton" Width="34" Height="34" HorizontalAlignment="Left"
                Cursor="Hand" ToolTip="选择颜色" Click="SwatchButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PartSwatch" CornerRadius="9"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Cheems.Brush.Border.Default}"
                            BorderThickness="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PartSwatch" Property="BorderBrush" Value="{DynamicResource Cheems.Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PartSwatch" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Popup x:Name="PartPickerPopup" Placement="MousePoint" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Closed="PickerPopup_Closed">
            <Border Width="236" Margin="10" Padding="14" CornerRadius="10"
                    Background="{DynamicResource Cheems.Brush.Background.Default}"
                    BorderBrush="{DynamicResource Cheems.Brush.Border.Default}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="3" BlurRadius="14" Opacity="0.24" />
                </Border.Effect>
                <StackPanel>
                    <!-- 当前颜色预览 + 手动色号输入 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PartPreviewSwatch" Width="30" Height="30" CornerRadius="8"
                                BorderBrush="{DynamicResource Cheems.Brush.Border.Default}" BorderThickness="1" />
                        <TextBox x:Name="PartHexBox" Grid.Column="1" Margin="10,0,0,0" Height="30"
                                 Padding="8,0" VerticalContentAlignment="Center"
                                 FontFamily="{DynamicResource Cheems.FontFamily.Mono}"
                                 Style="{StaticResource ColorPicker.HexBoxStyle}"
                                 TextChanged="HexBox_TextChanged" />
                    </Grid>

                    <!-- 预设色板：后台按 PresetColors 填充 -->
                    <UniformGrid x:Name="PartPresetGrid" Columns="9" Margin="0,12,0,0" />

                    <Grid x:Name="PartWheelSurface" Width="176" Height="176" Margin="0,14,0,0"
                          HorizontalAlignment="Left" Background="Transparent"
                          MouseLeftButtonDown="WheelSurface_MouseLeftButtonDown"
                          MouseMove="WheelSurface_MouseMove"
                          MouseLeftButtonUp="WheelSurface_MouseLeftButtonUp">
                        <Image x:Name="PartWheelImage" Width="176" Height="176" Stretch="None" />
                        <Canvas Width="176" Height="176" IsHitTestVisible="False">
                            <Ellipse x:Name="PartWheelThumb" Width="14" Height="14"
                                     Stroke="White" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.45" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>

                    <Canvas x:Name="PartBrightnessTrack" Width="176" Height="16" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Background="Transparent"
                            MouseLeftButtonDown="BrightnessTrack_MouseLeftButtonDown"
                            MouseMove="BrightnessTrack_MouseMove"
                            MouseLeftButtonUp="BrightnessTrack_MouseLeftButtonUp">
                        <Border x:Name="PartBrightnessBar" Width="176" Height="10" Canvas.Top="3"
                                CornerRadius="5" />
                        <Ellipse x:Name="PartBrightnessThumb" Width="16" Height="16" Canvas.Top="0"
                                 Stroke="White" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.45" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
