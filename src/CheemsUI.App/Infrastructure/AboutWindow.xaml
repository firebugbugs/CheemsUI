<Window x:Class="CheemsUI.App.Infrastructure.AboutWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 CheemsUI"
        Width="430" Height="280"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True">
    <Border Margin="8" Padding="28,25" Background="{Binding SurfaceBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.22" Color="#600A1624" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Width="42" Height="42"
                       Source="/CheemsUI.App;component/Assets/Branding/head_portrait.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="13,1,0,0">
                    <TextBlock Text="CheemsUI" FontSize="19" FontWeight="SemiBold" Foreground="{Binding PrimaryTextBrush}" />
                    <TextBlock Text="CSS → WPF component gallery" Margin="0,4,0,0" FontSize="11" Foreground="{Binding SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="1" x:Name="PartVersion" Margin="0,26,0,0" FontSize="13" Foreground="{Binding PrimaryTextBrush}" />
            <TextBlock Grid.Row="2" Margin="0,9,0,0" FontSize="13" Foreground="{Binding SecondaryTextBrush}">
                <Hyperlink NavigateUri="https://gitee.com/unbengable/cheems-ui" RequestNavigate="GiteeLink_RequestNavigate"
                           Foreground="{Binding AccentBrush}">https://gitee.com/unbengable/cheems-ui</Hyperlink>
            </TextBlock>
            <Button Grid.Row="3" Width="84" Height="34" HorizontalAlignment="Right" Click="CloseButton_Click"
                    Background="{Binding MutedSurfaceBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1"
                    Foreground="{Binding PrimaryTextBrush}" Cursor="Hand" Content="关闭" />
        </Grid>
    </Border>
</Window>
