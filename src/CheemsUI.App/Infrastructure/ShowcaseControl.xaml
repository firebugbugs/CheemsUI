<UserControl x:Class="CheemsUI.App.Infrastructure.ShowcaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:CheemsUI.App.Infrastructure"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="420">
    <Grid>
        <!-- 复杂控件展示卡片：标题 + 源码按钮 + 演示区 -->
        <Border Background="{DynamicResource Cheems.Brush.Background.Default}"
                BorderBrush="{DynamicResource Cheems.Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <Button x:Name="CodeButton"
                            DockPanel.Dock="Right"
                            Content="&lt;/&gt;"
                            Style="{StaticResource Cheems.App.Style.CodeButton}"
                            Margin="16,0,10,0"
                            MouseEnter="CodeButton_MouseEnter"
                            MouseLeave="CodeButton_MouseLeave"
                            Click="CodeButton_Click" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Cheems.Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- 演示区：展示台控件（浅/深背景可切换） -->
                <infra:DemoArea Grid.Row="1"
                                Demo="{Binding Demo, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Grid>
        </Border>

        <!-- 源码预览（规矩 M5）：hover 打开、移开关闭，只读 -->
        <Popup x:Name="CodePopup"
               PlacementTarget="{Binding ElementName=CodeButton}"
               Placement="Bottom"
               HorizontalOffset="-400"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Width="460"
                    MaxHeight="380"
                    Margin="12"
                    Background="{DynamicResource Cheems.Brush.Background.Default}"
                    BorderBrush="{DynamicResource Cheems.Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.18" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource Cheems.Brush.Background.Elevated}"
                            CornerRadius="7,7,0,0"
                            Padding="12,8"
                            BorderBrush="{DynamicResource Cheems.Brush.Border.Default}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="点击 &lt;/&gt; 复制"
                                       FontSize="11"
                                       Foreground="{DynamicResource Cheems.Brush.Text.Secondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Cheems.Brush.Text.Primary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="CodeText"
                                   FontFamily="{DynamicResource Cheems.FontFamily.Mono}"
                                   FontSize="12"
                                   Padding="12"
                                   Foreground="{DynamicResource Cheems.Brush.Text.Primary}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
