<Window x:Class="CheemsUI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:CheemsUI.App.Infrastructure"
        xmlns:backgrounds="clr-namespace:CheemsUI.App.Backgrounds"
        xmlns:pages="clr-namespace:CheemsUI.App.Pages"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:CheemsUI.App.ViewModels"
        mc:Ignorable="d"
        Title="CheemsUI Demo"
        Height="720" Width="1120"
        MinHeight="560" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Background="#E8E8E8"
        WindowStyle="None"
        FontFamily="{DynamicResource Cheems.FontFamily.Default}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        MouseMove="Window_MouseMove">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WelcomeViewModel}"><pages:WelcomePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ButtonsViewModel}"><pages:ButtonsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoadersViewModel}"><pages:LoadersPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InputsViewModel}"><pages:InputsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgressViewModel}"><pages:ProgressPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackgroundsViewModel}"><pages:BackgroundsPage /></DataTemplate>

        <!-- Window chrome colours are changed together by MainWindow according to the active background. -->
        <SolidColorBrush x:Key="App.Window.Background" Color="#E8E8E8" />
        <SolidColorBrush x:Key="App.Window.Border" Color="#D1D1D1" />
        <SolidColorBrush x:Key="App.Sidebar.Background" Color="#D9F5F5F5" />
        <SolidColorBrush x:Key="App.Navigation.Hover" Color="#BFECECEC" />
        <SolidColorBrush x:Key="App.Navigation.Selected" Color="#CCFFFFFF" />
        <SolidColorBrush x:Key="App.Text.Primary" Color="#202124" />
        <SolidColorBrush x:Key="App.Text.Secondary" Color="#74777C" />
        <SolidColorBrush x:Key="App.Accent" Color="#202124" />
        <SolidColorBrush x:Key="App.TitleBar.Icon.Background" Color="#202124" />
        <SolidColorBrush x:Key="App.TitleBar.Button.Foreground" Color="#4D4F53" />
        <SolidColorBrush x:Key="App.TitleBar.Button.Hover" Color="#DCDCDC" />
        <SolidColorBrush x:Key="App.TitleBar.Button.Pressed" Color="#D2D2D2" />
        <SolidColorBrush x:Key="App.Search.Background" Color="#FFFFFF" />
        <SolidColorBrush x:Key="App.Search.Border" Color="#E0E0E0" />
        <SolidColorBrush x:Key="App.Search.Icon" Color="#777A7F" />
        <SolidColorBrush x:Key="App.Sidebar.Footer.Background" Color="#CCECECEC" />
        <SolidColorBrush x:Key="App.Notification.Background" Color="#FFFFFF" />
        <SolidColorBrush x:Key="App.Notification.Border" Color="#D6D9DE" />

        <!-- 覆盖控件库的基础语义画刷，使每个延迟创建的演示页也能随背景更新。 -->
        <SolidColorBrush x:Key="Cheems.Brush.Text.Primary" Color="#2D3436" />
        <SolidColorBrush x:Key="Cheems.Brush.Text.Secondary" Color="#636E72" />
        <SolidColorBrush x:Key="Cheems.Brush.Background.Default" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Cheems.Brush.Background.Elevated" Color="#F5F6FA" />
        <SolidColorBrush x:Key="Cheems.Brush.Border.Default" Color="#DFE6E9" />

        <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource App.TitleBar.Button.Foreground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource App.TitleBar.Button.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource App.TitleBar.Button.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface" Background="Transparent" CornerRadius="8">
                            <ContentPresenter x:Name="ButtonContent"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#D94A4A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#BE3434" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBackground" MinHeight="46" Background="Transparent" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SelectionMark" Width="4" Height="20"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource App.Accent}"
                                        CornerRadius="0,3,3,0" Opacity="0" />
                                <ContentPresenter Grid.Column="1" Margin="13,0,12,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource App.Navigation.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource App.Navigation.Selected}" />
                                <Setter TargetName="SelectionMark" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <backgrounds:CheemsBirdsBackground x:Name="PartBirdsWindowBackground"
                                           Visibility="Collapsed" ClipRadius="12"
                                           Cursor="Arrow" />

        <Border x:Name="WindowFrame"
                Background="{DynamicResource App.Window.Background}"
                BorderBrush="{DynamicResource App.Window.Border}">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                 Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12,4,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" Background="{DynamicResource App.TitleBar.Icon.Background}" CornerRadius="7">
                        <TextBlock Text="C" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center"
                               Text="CheemsUI" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text.Primary}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                               Text="组件展示" FontSize="11"
                               Foreground="{DynamicResource App.Text.Secondary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="MinimizeButton_Click" AutomationProperties.Name="最小化">
                        <Path Width="10" Height="1" Stretch="Fill" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M 0,0 L 10,0 L 10,1 L 0,1 Z" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="MaximizeRestoreButton_Click" AutomationProperties.Name="最大化或还原">
                        <Border Width="10" Height="10" BorderThickness="1"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                            Click="CloseButton_Click" AutomationProperties.Name="关闭">
                        <Path Width="10" Height="10" Stretch="Fill"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="18,8,18,18"
                Background="{DynamicResource App.Sidebar.Background}" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.10"
                                  ShadowDepth="4" Color="#000000" />
            </Border.Effect>
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <infra:SidebarBrandControl Width="160" Height="62"
                                           Margin="0,1,0,11"
                                           HorizontalAlignment="Center"
                                           AutomationProperties.Name="CheemsUI，cheems.cn" />

                <StackPanel Grid.Row="1" Margin="2,0,2,14">
                    <TextBlock Margin="8,0,8,7" Text="搜索控件"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text.Secondary}" />
                    <Border Height="38" Background="{DynamicResource App.Search.Background}" CornerRadius="11"
                            BorderBrush="{DynamicResource App.Search.Border}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Stroke="{DynamicResource App.Search.Icon}" StrokeThickness="1.5"
                                  Data="M 8.5,8.5 L 13,13 M 11,5.5 A 5.5,5.5 0 1 1 0,5.5 A 5.5,5.5 0 1 1 11,5.5" />
                            <TextBox Grid.Column="1" Margin="9,0,9,0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="12" Foreground="{DynamicResource App.Text.Primary}"
                                     CaretBrush="{DynamicResource App.Text.Primary}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2" Margin="10,2,10,7" Text="组件"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text.Secondary}" />

                <ListBox Grid.Row="3" ItemsSource="{Binding GroupsView}"
                         SelectedItem="{Binding SelectedGroup}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource App.Text.Primary}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="4" Margin="2,10,2,2" Padding="12,10"
                        Background="{DynamicResource App.Sidebar.Footer.Background}" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="CheemsUI" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}" />
                        <TextBlock Text="CSS → WPF component gallery" Margin="0,3,0,0"
                                   FontSize="10" Foreground="{DynamicResource App.Text.Secondary}" />
                    </StackPanel>
                </Border>

                <Button x:Name="UpdateMenuButton" Grid.Row="5" Width="34" Height="30" Margin="2,8,0,0"
                        HorizontalAlignment="Left" Click="UpdateMenuButton_Click"
                        ToolTip="更多" AutomationProperties.Name="更多菜单"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="9">
                                <Path Width="16" Height="12" Stretch="Fill"
                                      Stroke="{DynamicResource App.Text.Secondary}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 1,1 L 15,1 M 1,6 L 15,6 M 1,11 L 15,11" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource App.Navigation.Hover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource App.Navigation.Selected}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="UpdateMenu" Placement="Top" PlacementTarget="{Binding ElementName=UpdateMenuButton}"
                                     Padding="5" Background="#FFFCFCFD" BorderBrush="#FFD9E1EA" BorderThickness="1">
                            <ContextMenu.Resources>
                                <Style TargetType="{x:Type MenuItem}">
                                    <Setter Property="Padding" Value="14,9,20,9" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Foreground" Value="#FF243247" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type MenuItem}">
                                                <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="ItemSurface" Property="Background" Value="#FFE8F1FF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ContextMenu.Resources>
                            <MenuItem Header="检查更新…" Click="CheckForUpdates_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Margin="20,18,28,22"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding SelectedGroup.PageViewModel}" />
            </Grid>

            <!-- 全局提示层：当前页面的 BaseViewModel 控制文本与三秒可见期。 -->
            <Border Grid.RowSpan="2"
                    Panel.ZIndex="10"
                    MaxWidth="420"
                    Margin="24,0,24,32"
                    Padding="18,11"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource App.Notification.Background}"
                    BorderBrush="{DynamicResource App.Notification.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    IsHitTestVisible="False"
                    Visibility="{Binding SelectedGroup.PageViewModel.IsNotificationVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      Direction="270"
                                      Opacity="0.16"
                                      ShadowDepth="5"
                                      Color="#000000" />
                </Border.Effect>
                <TextBlock Text="{Binding SelectedGroup.PageViewModel.NotificationMessage}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource App.Text.Primary}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
