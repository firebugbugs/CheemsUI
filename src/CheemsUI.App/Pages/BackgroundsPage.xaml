<UserControl x:Class="CheemsUI.App.Pages.BackgroundsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:backgrounds="clr-namespace:CheemsUI.App.Backgrounds"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="700">
    <UserControl.Resources>
        <Style x:Key="RestoreBackgroundCardStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="320" />
            <Setter Property="Height" Value="180" />
            <Setter Property="Margin" Value="0,0,20,20" />
            <Setter Property="Background" Value="#E8E8E8" />
            <Setter Property="BorderBrush" Value="#CFCFCF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PartCard" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PartCard" Property="BorderBrush" Value="#7A7A7A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PartCard" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,16">
            <TextBlock Text="背景 Backgrounds" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource Cheems.Brush.Text.Primary}" />
            <TextBlock Text="选择一张卡片即可将背景以 80% 透明度叠加到软件原始浅灰底色上。背景直接使用本地 three.js r134 与 Vanta 脚本，运行时不访问网络。"
                       Margin="0,8,0,24" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Cheems.Brush.Text.Secondary}" />

            <WrapPanel Visibility="{Binding IsBackgroundsVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                <Border Width="320" Height="180" Margin="0,0,20,20" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="#172642" BorderThickness="1">
                    <Grid>
                        <backgrounds:CheemsBirdsBackground IsPreview="True" ClipRadius="12"
                                                           ApplyRequested="BirdsBackground_ApplyRequested" />
                        <Button x:Name="BirdsCodeButton" Margin="0,12,12,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Content="&lt;/&gt;" ToolTip="复制 XAML"
                                Style="{StaticResource Cheems.App.Style.CodeButton}"
                                Click="BirdsCodeButton_Click" />
                    </Grid>
                </Border>

                <Border Width="320" Height="180" Margin="0,0,20,20" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="#172642" BorderThickness="1">
                    <Grid>
                        <backgrounds:CheemsCloudsBackground ClipRadius="12"
                                                            ApplyRequested="CloudsBackground_ApplyRequested" />
                        <Button x:Name="CloudsCodeButton" Margin="0,12,12,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Content="&lt;/&gt;" ToolTip="复制 XAML"
                                Style="{StaticResource Cheems.App.Style.CodeButton}"
                                Click="CloudsCodeButton_Click" />
                    </Grid>
                </Border>

                <Border Width="320" Height="180" Margin="0,0,20,20" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="#172642" BorderThickness="1">
                    <Grid>
                        <backgrounds:CheemsCellsBackground ClipRadius="12"
                                                           ApplyRequested="CellsBackground_ApplyRequested" />
                        <Button x:Name="CellsCodeButton" Margin="0,12,12,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Content="&lt;/&gt;" ToolTip="复制 XAML"
                                Style="{StaticResource Cheems.App.Style.CodeButton}"
                                Click="CellsCodeButton_Click" />
                    </Grid>
                </Border>

                <Button Style="{StaticResource RestoreBackgroundCardStyle}" Click="RestoreBackground_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="恢复默认" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Cheems.Brush.Text.Primary}" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,6,0,0" Text="使用软件原始浅灰背景" FontSize="12"
                                   Foreground="{DynamicResource Cheems.Brush.Text.Secondary}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
