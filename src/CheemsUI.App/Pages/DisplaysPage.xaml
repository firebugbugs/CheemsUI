<UserControl x:Class="CheemsUI.App.Pages.DisplaysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cheems="https://cheemsui.com/wpf"
             xmlns:infra="clr-namespace:CheemsUI.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,16">
            <TextBlock Text="显示 Displays" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource App.Text.OnBackground.Primary}" />
            <TextBlock Text="展示型控件由页面提供数据；下方翻页时钟直接绑定本机系统时间。"
                       Margin="0,8,0,24" FontSize="13"
                       Foreground="{DynamicResource App.Text.OnBackground.Secondary}" />

            <WrapPanel>
                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Displays/FlipClock.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsFlipClockVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsFlipClock Value="{Binding SystemTime, Mode=OneWay}" />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
