<UserControl x:Class="CheemsUI.App.Pages.InputsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cheems="https://cheemsui.com/wpf"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:CheemsUI.App.Infrastructure"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,16">

            <TextBlock Text="输入 Input"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource App.Text.OnBackground.Primary}" />
            <TextBlock Text="输入控件按原生控件语义分类展示；每个控件保留一个代表实例，并在空间允许时自动并排。"
                       Margin="0,8,0,24"
                       FontSize="13"
                       Foreground="{DynamicResource App.Text.OnBackground.Secondary}"
                       TextWrapping="Wrap" />

            <!-- ToggleButton / CheckBox 语义：具有开、关两种状态的切换控件。 -->
            <Grid Margin="0,0,0,18"
                  Visibility="{Binding IsSwitchSectionVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="6" Height="6" Margin="0,0,9,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Cheems.Brush.Text.Primary}"
                            CornerRadius="3" />
                    <TextBlock Text="Switch 开关"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Cheems.Brush.Text.Primary}" />
                    <TextBlock Text="{Binding VisibleSwitchCount}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Bottom"
                               FontSize="11"
                               Foreground="{DynamicResource Cheems.Brush.Text.Secondary}" />
                </StackPanel>
                <Border Grid.Column="1" Height="1" Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Cheems.Brush.Border.Default}" />
            </Grid>

            <WrapPanel Margin="0,0,0,8">
                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/DayNightSwitch.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsDayNightVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsDayNightSwitch Width="108" Height="54" />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/AmPmToggle.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsAmPmVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsAmPmToggle />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/CheckToggle.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsCheckToggleVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsCheckToggle />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/ScaleSwitch.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsScaleSwitchVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsScaleSwitch />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/MechanicalToggle.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsMechanicalToggleVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsMechanicalToggle />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/IosStretchSwitch.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsIosStretchSwitchVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsIosStretchSwitch IsChecked="True" />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/GenderToggle.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsGenderToggleVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsGenderToggle />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/LedSwitch.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsLedVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsLedSwitch />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/PixelSwitch.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsPixelVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsPixelSwitch />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/MetalSwitch.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsMetalVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsMetalSwitch />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/PixelCoinSwitch.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsPixelCoinVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsPixelCoinSwitch />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/RotarySwitch.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsRotarySwitchVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsRotarySwitch Width="230" Height="230" SelectedIndex="0">
                            <cheems:CheemsRotarySwitch.ItemsSource>
                                <x:Array Type="{x:Type sys:String}">
                                    <sys:String>OFF</sys:String>
                                    <sys:String>LOW</sys:String>
                                    <sys:String>MID</sys:String>
                                    <sys:String>HIGH</sys:String>
                                </x:Array>
                            </cheems:CheemsRotarySwitch.ItemsSource>
                        </cheems:CheemsRotarySwitch>
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/FaceSwitch.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsFaceSwitchVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsFaceSwitch IsChecked="True" />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/TrafficLightSwitch.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsTrafficLightSwitchVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsTrafficLightSwitch SelectedSignal="Yellow" />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/DarkTrafficLightSwitch.xaml.txt"
                                              Margin="0,0,32,28"
                                              Visibility="{Binding IsDarkTrafficLightSwitchVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsDarkTrafficLightSwitch SelectedSignal="Green" />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>
            </WrapPanel>

            <!-- TextBox 语义：可输入和编辑单行文本。 -->
            <Grid Margin="0,0,0,18"
                  Visibility="{Binding IsTextBoxSectionVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="6" Height="6" Margin="0,0,9,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Cheems.Brush.Text.Primary}"
                            CornerRadius="3" />
                    <TextBlock Text="TextBox 输入框"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Cheems.Brush.Text.Primary}" />
                    <TextBlock Text="2" Margin="6,0,0,0"
                               VerticalAlignment="Bottom" FontSize="11"
                               Foreground="{DynamicResource Cheems.Brush.Text.Secondary}" />
                </StackPanel>
                <Border Grid.Column="1" Height="1" Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Cheems.Brush.Border.Default}" />
            </Grid>

            <WrapPanel>
                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/GlowInput.xaml.txt"
                                              Margin="7,7,32,28"
                                              Visibility="{Binding IsGlowInputVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsGlowInput Placeholder="text" />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>

                <infra:CompactShowcaseControl Source="/CheemsUI.App;component/Sources/Inputs/SearchBox.xaml.txt"
                                              Margin="7,7,32,28"
                                              Visibility="{Binding IsSearchBoxVisible, Converter={StaticResource Cheems.App.Converter.BooleanToVisibility}}">
                    <infra:CompactShowcaseControl.Demo>
                        <cheems:CheemsSearchBox Label="Search"
                                                SearchCommand="{Binding TestEventCommand}" />
                    </infra:CompactShowcaseControl.Demo>
                </infra:CompactShowcaseControl>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
