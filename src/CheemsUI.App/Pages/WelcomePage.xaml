<UserControl x:Class="CheemsUI.App.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="820">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Welcome.Text.Primary" Color="#202124" />
        <SolidColorBrush x:Key="Welcome.Text.Secondary" Color="#74777C" />

        <Style x:Key="CategoryCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F5F5F5" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,14,18">
            <Border Padding="38,34"
                    Background="#202124"
                    CornerRadius="22"
                    ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" MinWidth="190" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <Border Width="92" Padding="10,5"
                                HorizontalAlignment="Left"
                                Background="#343538" CornerRadius="12">
                            <TextBlock Text="WELCOME" HorizontalAlignment="Center"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#D7D7D7" />
                        </Border>
                        <TextBlock Margin="0,20,0,0"
                                   Text="让网页创意，&#x0a;自然地来到 WPF。"
                                   FontSize="34" FontWeight="Bold"
                                   LineHeight="46" Foreground="White" />
                        <TextBlock Margin="0,18,34,0"
                                   Text="CheemsUI 专注于将优秀的 HTML/CSS 控件逐细节转换为可复用的原生 WPF 控件。"
                                   FontSize="13" LineHeight="22"
                                   Foreground="#B9BABC" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Height="210">
                        <Ellipse Width="168" Height="168" Fill="#2A2B2E"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="120" Height="120" Fill="#E8E8E8"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="0"
                                                  Opacity="0.22" Color="#FFFFFF" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Image Width="80" Height="80"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="/CheemsUI.App;component/Assets/Branding/head_portrait.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Ellipse Width="17" Height="17" Fill="#FFFFFF"
                                 Margin="0,20,26,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <Ellipse Width="9" Height="9" Fill="#77797E"
                                 Margin="20,0,0,22" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CategoryCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Border Width="38" Height="38" HorizontalAlignment="Left"
                                    Background="#202124" CornerRadius="11">
                                <TextBlock Text="B" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="16" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <TextBlock Text="06" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Welcome.Text.Secondary}" />
                        </Grid>
                        <TextBlock Margin="0,18,0,0" Text="按钮 Button"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Welcome.Text.Primary}" />
                        <TextBlock Margin="0,7,0,0" Text="交互明确、反馈自然的按钮控件。"
                                   FontSize="11" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource Welcome.Text.Secondary}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CategoryCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Border Width="38" Height="38" HorizontalAlignment="Left"
                                    Background="#FFFFFF" CornerRadius="11">
                                <TextBlock Text="L" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="16" FontWeight="SemiBold" Foreground="#202124" />
                            </Border>
                            <TextBlock Text="14" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Welcome.Text.Secondary}" />
                        </Grid>
                        <TextBlock Margin="0,18,0,0" Text="加载 Loader"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Welcome.Text.Primary}" />
                        <TextBlock Margin="0,7,0,0" Text="保留原版节奏与细节的加载动画。"
                                   FontSize="11" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource Welcome.Text.Secondary}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CategoryCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Border Width="38" Height="38" HorizontalAlignment="Left"
                                    Background="#DCDCDC" CornerRadius="11">
                                <TextBlock Text="I" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="16" FontWeight="SemiBold" Foreground="#202124" />
                            </Border>
                            <TextBlock Text="06" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Welcome.Text.Secondary}" />
                        </Grid>
                        <TextBlock Margin="0,18,0,0" Text="输入 Input"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Welcome.Text.Primary}" />
                        <TextBlock Margin="0,7,0,0" Text="开关、选择与评分等交互控件。"
                                   FontSize="11" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource Welcome.Text.Secondary}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,14,0,0" Padding="20,15"
                    Background="#F5F5F5" CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="#202124" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                               Text="从左侧选择分类，查看控件效果与对应源码。"
                               FontSize="12" Foreground="{StaticResource Welcome.Text.Secondary}" />
                    <TextBlock Grid.Column="2" Text="26 COMPONENTS"
                               VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource Welcome.Text.Primary}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
