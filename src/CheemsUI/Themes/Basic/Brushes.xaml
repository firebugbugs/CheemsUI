<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 字典自包含（CONVENTIONS R3.9）：自身合并 L1 色板，保证任何引用路径（App 合并/延迟实例化）下 StaticResource 都可解析 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- L2 语义画刷：只允许画刷，键 Cheems.Brush.*；颜色只准 StaticResource 引用 L1（CONVENTIONS R3.2） -->

