<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- toggleWrapper 的页面居中定位不属于控件；其 AM/PM、toggle、handler、crater 和六颗 star 均保留。 -->
    <Style TargetType="{x:Type local:CheemsAmPmToggle}">
        <Setter Property="Width" Value="188" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsAmPmToggle}">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="188" Height="50">
                            <Canvas.Clip>
                                <RectangleGeometry Rect="0,0,188,50" />
                            </Canvas.Clip>

                            <!-- .toggle::before / ::after -->
                            <TextBlock x:Name="PartAmText" Text="AM" Canvas.Left="0" Canvas.Top="15"
                                       Width="30" FontSize="18"
                                       Foreground="{DynamicResource Cheems.Brush.AmPmToggle.LabelBlue}" />
                            <TextBlock x:Name="PartPmText" Text="PM" Canvas.Left="158" Canvas.Top="15"
                                       Width="30" TextAlignment="Right" FontSize="18"
                                       Foreground="{DynamicResource Cheems.Brush.AmPmToggle.White}" />

                            <!-- .toggle 90×50，位于两个文字标签之间。 -->
                            <Canvas Width="90" Height="50" Canvas.Left="50">
                                <Border Width="90" Height="50" CornerRadius="25"
                                        Background="{DynamicResource Cheems.Brush.AmPmToggle.TrackDay}" />
                                <Border x:Name="PartNightTrack" Width="90" Height="50" CornerRadius="25" Opacity="0"
                                        Background="{DynamicResource Cheems.Brush.AmPmToggle.TrackNight}" />

                                <!-- z-index:0 的第 1、3、4、5、6 颗星。 -->
                                <Border x:Name="PartStar1" Width="30" Height="3" Canvas.Left="35" Canvas.Top="10"
                                        CornerRadius="15" Panel.ZIndex="0"
                                        Background="{DynamicResource Cheems.Brush.AmPmToggle.White}" />
                                <Border x:Name="PartStar3" Width="30" Height="3" Canvas.Left="40" Canvas.Top="27"
                                        CornerRadius="15" Panel.ZIndex="0"
                                        Background="{DynamicResource Cheems.Brush.AmPmToggle.White}" />
                                <Border x:Name="PartStar4" Width="2" Height="2" Canvas.Left="11" Canvas.Top="16"
                                        CornerRadius="1" Panel.ZIndex="0" Opacity="0"
                                        Background="{DynamicResource Cheems.Brush.AmPmToggle.White}" />
                                <Border x:Name="PartStar5" Width="3" Height="3" Canvas.Left="17" Canvas.Top="32"
                                        CornerRadius="1.5" Panel.ZIndex="0" Opacity="0"
                                        Background="{DynamicResource Cheems.Brush.AmPmToggle.White}" />
                                <Border x:Name="PartStar6" Width="2" Height="2" Canvas.Left="28" Canvas.Top="36"
                                        CornerRadius="1" Panel.ZIndex="0" Opacity="0"
                                        Background="{DynamicResource Cheems.Brush.AmPmToggle.White}" />

                                <!-- .toggle__handler：left/top 3，44×44，初始 rotate(-45deg)。 -->
                                <Grid x:Name="PartHandler" Width="44" Height="44"
                                      Canvas.Left="3" Canvas.Top="3" Panel.ZIndex="1">
                                    <Grid.Effect>
                                        <DropShadowEffect Color="{StaticResource Cheems.Color.AmPmToggle.Shadow}" BlurRadius="6"
                                                          ShadowDepth="2" Direction="270" Opacity="1" />
                                    </Grid.Effect>
                                    <Border CornerRadius="22"
                                            Background="{DynamicResource Cheems.Brush.AmPmToggle.HandlerDay}" />
                                    <Border x:Name="PartNightHandler" CornerRadius="22" Opacity="0"
                                            Background="{DynamicResource Cheems.Brush.AmPmToggle.HandlerNight}" />

                                    <Canvas x:Name="PartCraters" Width="44" Height="44" Opacity="0">
                                        <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="18"
                                                 Fill="{DynamicResource Cheems.Brush.AmPmToggle.Crater}" />
                                        <Ellipse Width="6" Height="6" Canvas.Left="22" Canvas.Top="28"
                                                 Fill="{DynamicResource Cheems.Brush.AmPmToggle.Crater}" />
                                        <Ellipse Width="8" Height="8" Canvas.Left="25" Canvas.Top="10"
                                                 Fill="{DynamicResource Cheems.Brush.AmPmToggle.Crater}" />
                                    </Canvas>
                                </Grid>

                                <!-- 第 2 颗星与 handler 同为 z-index:1，且源码中后声明，所以覆盖在 handler 上。 -->
                                <Border x:Name="PartStar2" Width="30" Height="3" Canvas.Left="28" Canvas.Top="18"
                                        CornerRadius="15" Panel.ZIndex="1"
                                        Background="{DynamicResource Cheems.Brush.AmPmToggle.White}" />
                            </Canvas>
                        </Canvas>
                    </Viewbox>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PartAmText" Property="Foreground"
                                    Value="{DynamicResource Cheems.Brush.AmPmToggle.White}" />
                            <Setter TargetName="PartPmText" Property="Foreground"
                                    Value="{DynamicResource Cheems.Brush.AmPmToggle.LabelBlue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
