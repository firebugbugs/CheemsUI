<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsCircuitProgressBar}">
        <Setter Property="Width" Value="320" />
        <Setter Property="Height" Value="100" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Value" Value="40" />
        <Setter Property="Step" Value="0.1" />
        <Setter Property="Text" Value="LOADING..." />
        <Setter Property="ProgressBrush" Value="{DynamicResource Cheems.Brush.CircuitProgress.Primary}" />
        <Setter Property="TrackBrush" Value="{DynamicResource Cheems.Brush.CircuitProgress.Neutral}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsCircuitProgressBar}">
                    <!-- 透明命中层替代原页面的 6×6 area；不引入页面网格或 Reload 按钮。 -->
                    <Grid x:Name="PartDragSurface" Background="Transparent" ClipToBounds="False">
                        <Viewport3D x:Name="PartViewport" IsHitTestVisible="False" ClipToBounds="False">
                            <Viewport3D.Camera>
                                <!-- CSS 未设置 perspective，OrthographicCamera 对应其平行投影。 -->
                                <OrthographicCamera Position="137.5,10,500"
                                                    LookDirection="0,0,-1"
                                                    UpDirection="0,1,0"
                                                    Width="320" />
                            </Viewport3D.Camera>
                            <ModelVisual3D x:Name="PartModelHost" />
                            <!-- .text：真实 2D 文字承载在 translateZ(-20px) 的 3D 平面上。 -->
                            <Viewport2DVisual3D x:Name="PartTextHost">
                                <Viewport2DVisual3D.Geometry>
                                    <MeshGeometry3D Positions="10,23,-20 210,23,-20 210,45,-20 10,45,-20"
                                                    TextureCoordinates="0,1 1,1 1,0 0,0"
                                                    TriangleIndices="0 1 2 0 2 3" />
                                </Viewport2DVisual3D.Geometry>
                                <Viewport2DVisual3D.Material>
                                    <DiffuseMaterial Brush="White"
                                                     Viewport2DVisual3D.IsVisualHostMaterial="True" />
                                </Viewport2DVisual3D.Material>
                                <Border Width="200" Height="22" Background="Transparent" IsHitTestVisible="False">
                                    <TextBlock Text="{TemplateBinding Text}"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Cheems.FontFamily.Default}"
                                               FontSize="16"
                                               FontWeight="Black"
                                               Foreground="{TemplateBinding ProgressBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Viewport2DVisual3D>
                        </Viewport3D>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PartDragSurface" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
