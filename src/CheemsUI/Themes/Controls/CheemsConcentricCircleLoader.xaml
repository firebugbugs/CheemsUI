<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsConcentricCircleLoader}">
        <Setter Property="Width" Value="192" />
        <Setter Property="Height" Value="192" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="BlueBrush" Value="{DynamicResource Cheems.Brush.ConcentricCircle.Blue}" />
        <Setter Property="PurpleBrush" Value="{DynamicResource Cheems.Brush.ConcentricCircle.Purple}" />
        <Setter Property="PinkBrush" Value="{DynamicResource Cheems.Brush.ConcentricCircle.Pink}" />
        <Setter Property="YellowBrush" Value="{DynamicResource Cheems.Brush.ConcentricCircle.Yellow}" />
        <Setter Property="PaleBlueBrush" Value="{DynamicResource Cheems.Brush.ConcentricCircle.PaleBlue}" />
        <Setter Property="CoreBrush" Value="{DynamicResource Cheems.Brush.ConcentricCircle.Core}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsConcentricCircleLoader}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
