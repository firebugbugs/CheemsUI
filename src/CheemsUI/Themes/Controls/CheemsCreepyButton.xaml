<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsCreepyButton}">
        <Setter Property="Width" Value="288" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Background" Value="{DynamicResource Cheems.Brush.CreepyButton.Cover}" />
        <Setter Property="Foreground" Value="{DynamicResource Cheems.Brush.CreepyButton.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Cheems.FontFamily.Default}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsCreepyButton}">
                    <Viewbox Stretch="Fill" ClipToBounds="False">
                        <Canvas Width="288" Height="80" ClipToBounds="False">
                            <!-- CSS button background. -->
                            <Border Width="288" Height="80"
                                    Background="{DynamicResource Cheems.Brush.CreepyButton.Base}"
                                    CornerRadius="40" />

                            <!-- .creepy-btn__eyes: right 1em, bottom .5em. -->
                            <StackPanel x:Name="PartEyes" Canvas.Left="196" Canvas.Top="40"
                                        Width="60" Height="24" Orientation="Horizontal">
                                <Grid x:Name="PartEyeOne" Width="24" Height="24">
                                    <Grid.Clip>
                                        <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                                    </Grid.Clip>
                                    <Ellipse Fill="{DynamicResource Cheems.Brush.CreepyButton.Eye}" />
                                    <Ellipse x:Name="PartPupilOne" Width="12" Height="12"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="{DynamicResource Cheems.Brush.CreepyButton.Pupil}" />
                                </Grid>
                                <Grid Width="12" />
                                <Grid x:Name="PartEyeTwo" Width="24" Height="24">
                                    <Grid.Clip>
                                        <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                                    </Grid.Clip>
                                    <Ellipse Fill="{DynamicResource Cheems.Brush.CreepyButton.Eye}" />
                                    <Ellipse x:Name="PartPupilTwo" Width="12" Height="12"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="{DynamicResource Cheems.Brush.CreepyButton.Pupil}" />
                                </Grid>
                            </StackPanel>

                            <!-- .creepy-btn__cover: inset 0, transform-origin 1.25em 50%. -->
                            <Border x:Name="PartCover" Width="288" Height="80"
                                    Padding="32,16"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Cheems.Brush.CreepyButton.Base}"
                                    BorderThickness="4"
                                    CornerRadius="40">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>

                            <!-- 固定命中面：盖板旋转时鼠标仍停留在按钮范围内，避免 Enter/Leave 抖动。 -->
                            <Border Width="288" Height="80" Background="Transparent" />

                            <!-- CSS focus-visible outline; transparent during pointer-only interaction. -->
                            <Border x:Name="PartFocusOutline" Canvas.Left="-6" Canvas.Top="-6"
                                    Width="300" Height="92" BorderThickness="6" CornerRadius="46"
                                    BorderBrush="{DynamicResource Cheems.Brush.CreepyButton.Focus}"
                                    IsHitTestVisible="False" Opacity="0" />
                        </Canvas>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
