<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <Style TargetType="{x:Type local:CheemsCubeLoadingLoader}">
        <!-- 最大帧 translateZ(16)+正面24=40px；350px 透视将 336px 网格放大至约379.4px。 -->
        <Setter Property="Width" Value="384"/><Setter Property="Height" Value="82"/>
        <Setter Property="Focusable" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsCubeLoadingLoader}">
                    <Viewbox Stretch="Uniform">
                        <local:CheemsCubeLoadingSurface Width="384" Height="82"/>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
