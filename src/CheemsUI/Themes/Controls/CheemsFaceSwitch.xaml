<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsFaceSwitch}">
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsFaceSwitch}">
                    <Viewbox Stretch="Uniform">
                        <!-- .check: 2.2 times the 40 px size variable by one size unit. -->
                        <Canvas x:Name="PartRoot" Width="88" Height="40">
                            <Border x:Name="PartGradientTrack" Canvas.Left="0" Canvas.Top="0"
                                    Width="88" Height="40" CornerRadius="20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{StaticResource Cheems.Color.FaceSwitch.GradientStart}" />
                                        <GradientStop Offset="1" Color="{StaticResource Cheems.Color.FaceSwitch.GradientEnd}" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- label -->
                            <Border x:Name="PartTrack" Canvas.Left="0" Canvas.Top="0"
                                    Width="88" Height="40" CornerRadius="20"
                                    Background="{StaticResource Cheems.Brush.FaceSwitch.TrackOff}" />

                            <!-- input[type=checkbox]: 32 px square at (4,4). -->
                            <Border x:Name="PartThumb" Canvas.Left="4" Canvas.Top="4"
                                    Width="32" Height="32"
                                    CornerRadius="16" Panel.ZIndex="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{StaticResource Cheems.Color.FaceSwitch.ThumbStart}" />
                                        <GradientStop Offset="1" Color="{StaticResource Cheems.Color.FaceSwitch.ThumbEnd}" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource Cheems.Color.FaceSwitch.Shadow}"
                                                      Direction="270" ShadowDepth="6"
                                                      BlurRadius="12" Opacity="0.3" />
                                </Border.Effect>
                            </Border>

                            <!-- label::before: the two eye dots. -->
                            <Canvas x:Name="PartEyes" Canvas.Left="6" Canvas.Top="18"
                                    Width="18" Height="6"
                                    Panel.ZIndex="2" RenderTransformOrigin="0,0">
                                <Ellipse Width="3" Height="2"
                                         Fill="{StaticResource Cheems.Brush.FaceSwitch.Expression}" />
                                <Ellipse Canvas.Left="10" Width="3" Height="2"
                                         Fill="{StaticResource Cheems.Brush.FaceSwitch.Expression}" />
                                <Canvas.RenderTransform>
                                    <ScaleTransform x:Name="PartEyesFlip" ScaleX="1" ScaleY="1" />
                                </Canvas.RenderTransform>
                            </Canvas>

                            <!-- label::after: clipped "●" glyph, reconstructed as its filled lower-half silhouette. -->
                            <local:CheemsFaceMouth x:Name="PartMouth" Canvas.Left="8" Canvas.Top="25"
                                                   Width="14" Height="8"
                                                   Stroke="{StaticResource Cheems.Brush.FaceSwitch.Expression}"
                                                   Panel.ZIndex="2" RenderTransformOrigin="0,0">
                                <local:CheemsFaceMouth.RenderTransform>
                                    <ScaleTransform x:Name="PartMouthFlip" ScaleX="1" ScaleY="1" />
                                </local:CheemsFaceMouth.RenderTransform>
                            </local:CheemsFaceMouth>
                        </Canvas>
                    </Viewbox>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PartTrack" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PartThumb" Storyboard.TargetProperty="(Canvas.Left)"
                                                         To="52" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PartEyes" Storyboard.TargetProperty="(Canvas.Left)"
                                                         To="64" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PartEyes" Storyboard.TargetProperty="(Canvas.Top)"
                                                         To="17" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PartMouth" Storyboard.TargetProperty="(Canvas.Left)"
                                                         To="64" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PartMouth" Storyboard.TargetProperty="(Canvas.Top)"
                                                         To="21" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PartMouth" Storyboard.TargetProperty="SmileProgress"
                                                         To="1" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartEyesFlip" Storyboard.TargetProperty="ScaleX">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.121" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.175" Value="-1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.229" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartMouthFlip" Storyboard.TargetProperty="ScaleX">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.121" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.175" Value="-1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.229" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PartTrack" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PartThumb" Storyboard.TargetProperty="(Canvas.Left)"
                                                         To="4" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PartEyes" Storyboard.TargetProperty="(Canvas.Left)"
                                                         To="6" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PartEyes" Storyboard.TargetProperty="(Canvas.Top)"
                                                         To="18" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PartMouth" Storyboard.TargetProperty="(Canvas.Left)"
                                                         To="8" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PartMouth" Storyboard.TargetProperty="(Canvas.Top)"
                                                         To="25" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PartMouth" Storyboard.TargetProperty="SmileProgress"
                                                         To="0" Duration="0:0:0.35" AccelerationRatio="0.5" DecelerationRatio="0.5" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartEyesFlip" Storyboard.TargetProperty="ScaleX">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.121" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.175" Value="-1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.229" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartMouthFlip" Storyboard.TargetProperty="ScaleX">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.121" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.175" Value="-1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.229" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PartRoot" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="No" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
