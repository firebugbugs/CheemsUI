<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsFlightProgressBar}">
        <Setter Property="Width" Value="600" />
        <Setter Property="Height" Value="96" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Value" Value="40" />
        <Setter Property="Step" Value="0.1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsFlightProgressBar}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{TemplateBinding Origin}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   FontFamily="{DynamicResource Cheems.FontFamily.Default}" FontSize="20" FontWeight="Light"
                                   Foreground="{DynamicResource Cheems.Brush.FlightProgress.Text}" />

                        <Grid Grid.Column="1" Height="96" Background="Transparent">
                            <Canvas x:Name="PartTrackSurface" Height="96" Background="Transparent">
                                <Border x:Name="PartBaseTrack" Canvas.Top="45" Height="6" CornerRadius="3"
                                        Margin="0" Background="{DynamicResource Cheems.Brush.FlightProgress.Track}" />
                                <Ellipse x:Name="PartStartDot" Canvas.Top="42" Width="12" Height="12" Fill="{DynamicResource Cheems.Brush.FlightProgress.Track}" />
                                <Ellipse x:Name="PartEndDot" Width="12" Height="12" Canvas.Top="42"
                                         Fill="{DynamicResource Cheems.Brush.FlightProgress.Track}" />

                                <Border x:Name="PartProgressFill" Canvas.Top="46" Height="4"
                                        Background="{DynamicResource Cheems.Brush.FlightProgress.Completed}" />
                                <Ellipse x:Name="PartCompletedStartDot" Canvas.Top="43" Width="10" Height="10" Fill="{DynamicResource Cheems.Brush.FlightProgress.Completed}" />

                                <Grid x:Name="PartCloudOne" Canvas.Left="135" Canvas.Top="8" Width="52" Height="24" Opacity="0.9" IsHitTestVisible="False">
                                    <Ellipse Width="34" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource Cheems.Brush.FlightProgress.Cloud}" />
                                    <Ellipse Width="24" Height="22" Margin="14,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource Cheems.Brush.FlightProgress.Cloud}" />
                                    <Ellipse Width="28" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource Cheems.Brush.FlightProgress.Cloud}" />
                                </Grid>
                                <Grid x:Name="PartCloudTwo" Canvas.Left="215" Canvas.Top="66" Width="58" Height="24" Opacity="0.9" IsHitTestVisible="False">
                                    <Ellipse Width="36" Height="15" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource Cheems.Brush.FlightProgress.Cloud}" />
                                    <Ellipse Width="22" Height="22" Margin="15,0,0,1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource Cheems.Brush.FlightProgress.Cloud}" />
                                    <Ellipse Width="31" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource Cheems.Brush.FlightProgress.Cloud}" />
                                </Grid>

                                <Grid x:Name="PartPlane" Canvas.Top="16" Width="64" Height="64"
                                      RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="100" Height="100">
                                            <!-- fuselage -->
                                            <Path Fill="{DynamicResource Cheems.Brush.FlightProgress.Plane}"
                                                  Data="M3,45 C24,42 50,39 78,39 C90,39 98,45 100,50 C98,55 90,61 78,61 C50,61 24,58 3,55 L10,50 Z" />
                                            <!-- tail and wings -->
                                            <Path Fill="{DynamicResource Cheems.Brush.FlightProgress.Accent}"
                                                  Data="M2,44 L15,43 L25,48 L25,52 L15,57 L2,56 L8,50 Z M37,41 L40,3 L51,3 L59,41 Z M37,59 L40,97 L51,97 L59,59 Z" />
                                            <!-- engines -->
                                            <Ellipse Canvas.Left="48" Canvas.Top="21" Width="18" Height="9" Fill="Black" />
                                            <Ellipse Canvas.Left="48" Canvas.Top="70" Width="18" Height="9" Fill="Black" />
                                            <!-- pilot window -->
                                            <Ellipse Canvas.Left="76" Canvas.Top="42" Width="16" Height="16"
                                                     Fill="{DynamicResource Cheems.Brush.FlightProgress.Cockpit}" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Canvas>
                            <!-- 拖动宽度与飞机中心的实际航程一致。 -->
                            <Border x:Name="PartDragSurface" Margin="32,0" Background="Transparent" />
                        </Grid>

                        <TextBlock Grid.Column="2" Text="{TemplateBinding Destination}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontFamily="{DynamicResource Cheems.FontFamily.Default}" FontSize="20" FontWeight="Light"
                                   Foreground="{DynamicResource Cheems.Brush.FlightProgress.Text}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
