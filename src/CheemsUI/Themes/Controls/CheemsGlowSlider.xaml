<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <Style TargetType="{x:Type local:CheemsGlowSlider}">
        <Setter Property="Width" Value="360" />
        <Setter Property="Height" Value="96" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Value" Value="50" />
        <Setter Property="Step" Value="0.1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsGlowSlider}">
                    <Grid Background="Transparent">
                        <Canvas x:Name="PartTrackSurface" Height="96" Background="Transparent">
                            <!-- 暗色内凹轨道 -->
                            <Border x:Name="PartTrack" Canvas.Top="40" Height="16" CornerRadius="8"
                                    Background="#343133" BorderBrush="#16000000" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="90" ShadowDepth="1"
                                                      BlurRadius="3" Opacity="0.75" />
                                </Border.Effect>
                            </Border>

                            <!-- 两层填充把实体颜色与柔和泛光分开 -->
                            <Border x:Name="PartFillGlow" Canvas.Top="40" Height="16" CornerRadius="8,2,2,8" />
                            <Border x:Name="PartFill" Canvas.Top="41" Height="14" CornerRadius="7,1,1,7"
                                    BorderBrush="#42FFFFFF" BorderThickness="0,1,0,0" />

                            <!-- 机械式旋钮：外光、金属盘、十字纹和中心光点 -->
                            <Grid x:Name="PartThumb" Canvas.Top="16" Width="64" Height="64"
                                  RenderTransformOrigin="0.5,0.5">
                                <Ellipse x:Name="PartThumbGlow" Margin="10" />
                                <Ellipse Margin="5" Stroke="#18000000" StrokeThickness="1">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.4,0.36" GradientOrigin="0.35,0.3" RadiusX="0.72" RadiusY="0.72">
                                            <GradientStop Color="#747174" Offset="0" />
                                            <GradientStop Color="#545153" Offset="0.55" />
                                            <GradientStop Color="#2B292B" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="Black" Direction="315" ShadowDepth="5"
                                                          BlurRadius="8" Opacity="0.58" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Margin="13" Fill="#343133" Stroke="#2DFFFFFF" StrokeThickness="1" />
                                <Rectangle Width="20" Height="5" RadiusX="2.5" RadiusY="2.5"
                                           Fill="#44000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Width="5" Height="20" RadiusX="2.5" RadiusY="2.5"
                                           Fill="#44000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse x:Name="PartThumbCore" Width="13" Height="13"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="5" Height="5" Fill="#AFFFFFFF"
                                         Margin="-3,-3,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Canvas>
                        <!-- 实际拖动区对应旋钮中心的完整行程。 -->
                        <Border x:Name="PartDragSurface" Margin="32,0" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PartThumb" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="1.035" ScaleY="1.035" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
