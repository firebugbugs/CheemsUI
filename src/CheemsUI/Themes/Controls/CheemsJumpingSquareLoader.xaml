<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsJumpingSquareLoader}">
        <!-- CSS 本体仍为 48×48；70px 透明布局宽度用于容纳方块旋转到 45° 时约 67.9px 的外接框。 -->
        <Setter Property="Width" Value="70" />
        <Setter Property="Height" Value="66" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsJumpingSquareLoader}">
                    <Canvas Width="70" Height="66">
                        <!-- ::before：top:60px; width:48px; height:5px; border-radius:50% -->
                        <Ellipse x:Name="PartShadow"
                                 Width="48" Height="5"
                                 Canvas.Left="11" Canvas.Top="60"
                                 Fill="{DynamicResource Cheems.Brush.JumpingSquareLoader.Shadow}" />

                        <!-- ::after：48×48、#f08080、4px 圆角。 -->
                        <Border x:Name="PartBody"
                                Width="48" Height="48"
                                Canvas.Left="11" Canvas.Top="0"
                                Background="{DynamicResource Cheems.Brush.JumpingSquareLoader.Body}"
                                CornerRadius="4" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
