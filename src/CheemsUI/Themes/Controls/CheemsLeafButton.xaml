<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsLeafButton}">
        <Setter Property="Padding" Value="45,15" />
        <Setter Property="Background" Value="{DynamicResource Cheems.Brush.LeafButton.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cheems.Brush.LeafButton.Background}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Cheems.Brush.LeafButton.Text}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsLeafButton}">
                    <!-- 下方 17px 透明区域容纳植物 SVG 溢出与阴影。 -->
                    <Grid>
                        <Border x:Name="Surface" Margin="4,4,4,17"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Direction="315" ShadowDepth="2.828" BlurRadius="3" Color="#33000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>

                        <Grid Margin="4,4,4,17" IsHitTestVisible="False" ClipToBounds="False">
                            <Image x:Name="PartIcon1" Width="25" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Source="/CheemsUI;component/Resources/Images/LeafButton/leaf1.png" Stretch="Uniform">
                                <Image.Effect><DropShadowEffect Direction="315" ShadowDepth="2.828" BlurRadius="3" Color="#4D000000" /></Image.Effect>
                            </Image>
                            <Image x:Name="PartIcon2" Width="12" Margin="25,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Source="/CheemsUI;component/Resources/Images/LeafButton/leaf2.png" Stretch="Uniform">
                                <Image.Effect><DropShadowEffect Direction="315" ShadowDepth="2.828" BlurRadius="3" Color="#80000000" /></Image.Effect>
                            </Image>
                            <Image x:Name="PartIcon3" Width="18" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Source="/CheemsUI;component/Resources/Images/LeafButton/leaf3.png" Stretch="Uniform">
                                <Image.Effect><DropShadowEffect Direction="315" ShadowDepth="2.828" BlurRadius="3" Color="#80000000" /></Image.Effect>
                            </Image>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Cheems.Brush.LeafButton.HoverBorder}" />
                            <Setter TargetName="Surface" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0.456,1" EndPoint="0.544,0">
                                        <GradientStop Offset="0" Color="#FEC195" />
                                        <GradientStop Offset="0.25" Color="#FCC196" />
                                        <GradientStop Offset="0.5" Color="#FABD92" />
                                        <GradientStop Offset="0.75" Color="#FAC097" />
                                        <GradientStop Offset="1" Color="#FAC39C" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
