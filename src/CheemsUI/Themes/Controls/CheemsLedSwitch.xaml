<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsLedSwitch}">
        <Setter Property="Width" Value="150" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsLedSwitch}">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="150" Height="60">
                            <!-- .switch-container：浏览器将 50px 圆角归一化为 30px。 -->
                            <Border CornerRadius="30"
                                    Background="{DynamicResource Cheems.Brush.LedSwitch.Container}" />

                            <!--
                              inset 8px 8px 16px #b0b0b0 与 inset -8px -8px 16px #fff：
                              对完整圆角轮廓做位移和 16px 模糊，再按底座药丸轮廓裁剪。
                            -->
                            <Canvas Width="150" Height="60" IsHitTestVisible="False">
                                <Canvas.Clip>
                                    <RectangleGeometry Rect="0,0,150,60" RadiusX="30" RadiusY="30" />
                                </Canvas.Clip>
                                <!-- CSS 第二条深色阴影先绘制：外部实心区域减去药丸孔洞。 -->
                                <Path Canvas.Left="8" Canvas.Top="8"
                                      Fill="{DynamicResource Cheems.Brush.LedSwitch.ShadowOffDark}">
                                    <Path.Data>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <RectangleGeometry Rect="-100,-100,350,260" />
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <RectangleGeometry Rect="0,0,150,60" RadiusX="30" RadiusY="30" />
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Path.Data>
                                    <Path.Effect>
                                        <BlurEffect Radius="16" />
                                    </Path.Effect>
                                </Path>
                                <!-- CSS 第一条白色阴影在上层。 -->
                                <Path Canvas.Left="-8" Canvas.Top="-8"
                                      Fill="{DynamicResource Cheems.Brush.LedSwitch.ShadowLight}">
                                    <Path.Data>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <RectangleGeometry Rect="-100,-100,350,260" />
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <RectangleGeometry Rect="0,0,150,60" RadiusX="30" RadiusY="30" />
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Path.Data>
                                    <Path.Effect>
                                        <BlurEffect Radius="16" />
                                    </Path.Effect>
                                </Path>
                            </Canvas>

                            <!-- .switch：完整交互区，并按 150×60 药丸轮廓裁剪内部拨块和投影。 -->
                            <Canvas Width="150" Height="60">
                                <Canvas.Clip>
                                    <RectangleGeometry Rect="0,0,150,60" RadiusX="30" RadiusY="30" />
                                </Canvas.Clip>

                                <!-- .toggle：left 5→65，top 5，80×50。 -->
                                <Grid x:Name="PartToggle" Width="80" Height="50"
                                      Canvas.Left="5" Canvas.Top="5">

                                    <!-- 未选中阴影；hover 只在该组内部交叉淡化。 -->
                                    <Grid x:Name="PartUncheckedShadows">
                                        <Border x:Name="PartBaseDarkShadow" CornerRadius="25"
                                                Background="{DynamicResource Cheems.Brush.LedSwitch.ToggleOff}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{StaticResource Cheems.Color.LedSwitch.ShadowOffDark}"
                                                                  BlurRadius="8" ShadowDepth="5.656854249"
                                                                  Direction="315" Opacity="0.3" />
                                            </Border.Effect>
                                        </Border>
                                        <Border x:Name="PartBaseLightShadow" CornerRadius="25"
                                                Background="{DynamicResource Cheems.Brush.LedSwitch.ToggleOff}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{StaticResource Cheems.Color.LedSwitch.ShadowLight}"
                                                                  BlurRadius="8" ShadowDepth="5.656854249"
                                                                  Direction="135" Opacity="0.75" />
                                            </Border.Effect>
                                        </Border>
                                        <Border x:Name="PartHoverDarkShadow" CornerRadius="25" Opacity="0"
                                                Background="{DynamicResource Cheems.Brush.LedSwitch.ToggleOff}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{StaticResource Cheems.Color.LedSwitch.ShadowHoverDark}"
                                                                  BlurRadius="12" ShadowDepth="5.656854249"
                                                                  Direction="315" Opacity="0.3" />
                                            </Border.Effect>
                                        </Border>
                                        <Border x:Name="PartHoverLightShadow" CornerRadius="25" Opacity="0"
                                                Background="{DynamicResource Cheems.Brush.LedSwitch.ToggleOff}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{StaticResource Cheems.Color.LedSwitch.ShadowLight}"
                                                                  BlurRadius="12" ShadowDepth="5.656854249"
                                                                  Direction="135" Opacity="0.75" />
                                            </Border.Effect>
                                        </Border>
                                    </Grid>

                                    <!-- 选中阴影拥有更高 CSS specificity，checked + hover 时仍使用本组。 -->
                                    <Grid x:Name="PartCheckedShadows" Opacity="0">
                                        <Border CornerRadius="25"
                                                Background="{DynamicResource Cheems.Brush.LedSwitch.ToggleOn}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{StaticResource Cheems.Color.LedSwitch.ShadowOnDark}"
                                                                  BlurRadius="8" ShadowDepth="5.656854249"
                                                                  Direction="315" Opacity="0.3" />
                                            </Border.Effect>
                                        </Border>
                                        <Border CornerRadius="25"
                                                Background="{DynamicResource Cheems.Brush.LedSwitch.ToggleOn}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{StaticResource Cheems.Color.LedSwitch.ShadowLight}"
                                                                  BlurRadius="8" ShadowDepth="5.656854249"
                                                                  Direction="135" Opacity="0.75" />
                                            </Border.Effect>
                                        </Border>
                                    </Grid>

                                    <!-- 145deg 的 CSS 渐变换算为单位方框中的 (0.15,0)→(0.85,1)。 -->
                                    <Border CornerRadius="25">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                                                <GradientStop x:Name="PartToggleStart"
                                                              Offset="0"
                                                              Color="{StaticResource Cheems.Color.LedSwitch.ToggleOffStart}" />
                                                <GradientStop x:Name="PartToggleEnd"
                                                              Offset="1"
                                                              Color="{StaticResource Cheems.Color.LedSwitch.ToggleOffEnd}" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- spread 2px / 4px 通过独立的 14px / 18px 光晕载体表达。 -->
                                    <Canvas Width="80" Height="50">
                                        <Ellipse x:Name="PartLedGlow" Width="14" Height="14"
                                                 Canvas.Left="8" Canvas.Top="18">
                                            <Ellipse.Fill>
                                                <SolidColorBrush x:Name="PartLedGlowBrush"
                                                                 Color="{StaticResource Cheems.Color.LedSwitch.LedOffGlow}" />
                                            </Ellipse.Fill>
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="PartLedGlowEffect"
                                                                  Color="{StaticResource Cheems.Color.LedSwitch.LedOffGlow}"
                                                                  BlurRadius="10" ShadowDepth="0" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse Width="10" Height="10" Canvas.Left="10" Canvas.Top="20">
                                            <Ellipse.Fill>
                                                <SolidColorBrush x:Name="PartLedBrush"
                                                                 Color="{StaticResource Cheems.Color.LedSwitch.LedOff}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Canvas>
                                </Grid>
                            </Canvas>
                        </Grid>
                    </Viewbox>

                    <ControlTemplate.Triggers>
                        <!-- .switch:hover .toggle；checked 时由更高 specificity 的选中组覆盖。 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartBaseLightShadow" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartBaseDarkShadow" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartHoverLightShadow" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartHoverDarkShadow" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartBaseLightShadow" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartBaseDarkShadow" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartHoverLightShadow" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartHoverDarkShadow" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartToggle"
                                                                       Storyboard.TargetProperty="(Canvas.Left)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="65" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartUncheckedShadows" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartCheckedShadows" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartToggleStart" Storyboard.TargetProperty="Color">
                                            <SplineColorKeyFrame KeyTime="0:0:0.3" Value="{StaticResource Cheems.Color.LedSwitch.ToggleOnStart}" KeySpline="0.42,0 0.58,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartToggleEnd" Storyboard.TargetProperty="Color">
                                            <SplineColorKeyFrame KeyTime="0:0:0.3" Value="{StaticResource Cheems.Color.LedSwitch.ToggleOnEnd}" KeySpline="0.42,0 0.58,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartLedBrush" Storyboard.TargetProperty="Color">
                                            <SplineColorKeyFrame KeyTime="0:0:0.3" Value="{StaticResource Cheems.Color.LedSwitch.LedOn}" KeySpline="0.42,0 0.58,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlowBrush" Storyboard.TargetProperty="Color">
                                            <SplineColorKeyFrame KeyTime="0:0:0.3" Value="{StaticResource Cheems.Color.LedSwitch.LedOn}" KeySpline="0.42,0 0.58,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlow"
                                                                      Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)">
                                            <SplineColorKeyFrame KeyTime="0:0:0.3" Value="{StaticResource Cheems.Color.LedSwitch.LedOn}" KeySpline="0.42,0 0.58,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlow" Storyboard.TargetProperty="Width">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="18" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlow" Storyboard.TargetProperty="Height">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="18" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlow" Storyboard.TargetProperty="(Canvas.Left)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="6" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlow" Storyboard.TargetProperty="(Canvas.Top)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="16" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlow"
                                                                       Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="15" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartToggle" Storyboard.TargetProperty="(Canvas.Left)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="5" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartUncheckedShadows" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartCheckedShadows" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartToggleStart" Storyboard.TargetProperty="Color">
                                            <SplineColorKeyFrame KeyTime="0:0:0.3" Value="{StaticResource Cheems.Color.LedSwitch.ToggleOffStart}" KeySpline="0.42,0 0.58,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartToggleEnd" Storyboard.TargetProperty="Color">
                                            <SplineColorKeyFrame KeyTime="0:0:0.3" Value="{StaticResource Cheems.Color.LedSwitch.ToggleOffEnd}" KeySpline="0.42,0 0.58,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartLedBrush" Storyboard.TargetProperty="Color">
                                            <SplineColorKeyFrame KeyTime="0:0:0.3" Value="{StaticResource Cheems.Color.LedSwitch.LedOff}" KeySpline="0.42,0 0.58,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlowBrush" Storyboard.TargetProperty="Color">
                                            <SplineColorKeyFrame KeyTime="0:0:0.3" Value="{StaticResource Cheems.Color.LedSwitch.LedOffGlow}" KeySpline="0.42,0 0.58,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlow"
                                                                      Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)">
                                            <SplineColorKeyFrame KeyTime="0:0:0.3" Value="{StaticResource Cheems.Color.LedSwitch.LedOffGlow}" KeySpline="0.42,0 0.58,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlow" Storyboard.TargetProperty="Width">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="14" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlow" Storyboard.TargetProperty="Height">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="14" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlow" Storyboard.TargetProperty="(Canvas.Left)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="8" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlow" Storyboard.TargetProperty="(Canvas.Top)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="18" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartLedGlow"
                                                                       Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="10" KeySpline="0.42,0 0.58,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
