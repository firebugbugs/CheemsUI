<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsMechanicalToggle}">
        <Setter Property="Width" Value="108" />
        <Setter Property="Height" Value="68" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsMechanicalToggle}">
                    <!-- 80×40 本体居中于 108×68 阴影画布。 -->
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="PartRoot" Width="108" Height="68" Background="Transparent">
                            <!-- checked 时 slider 的 0 0 15px emerald 外发光。 -->
                            <Border x:Name="PartTrackGlow" Canvas.Left="14" Canvas.Top="14"
                                    Width="80" Height="40" CornerRadius="20"
                                    Background="{DynamicResource Cheems.Brush.MechanicalToggle.On}"
                                    Opacity="0" IsHitTestVisible="False">
                                <Border.Effect>
                                    <BlurEffect Radius="15" />
                                </Border.Effect>
                            </Border>

                            <Border Canvas.Left="14" Canvas.Top="14" Width="80" Height="40"
                                    CornerRadius="20"
                                    Background="{DynamicResource Cheems.Brush.MechanicalToggle.Background}"
                                    BorderBrush="{DynamicResource Cheems.Brush.MechanicalToggle.TrackBorder}"
                                    BorderThickness="1" />

                            <!-- slider overflow:hidden：导轨和 glow 均受药丸轮廓裁剪。 -->
                            <Canvas Canvas.Left="14" Canvas.Top="14" Width="80" Height="40">
                                <Canvas.Clip>
                                    <RectangleGeometry Rect="0,0,80,40" RadiusX="20" RadiusY="20" />
                                </Canvas.Clip>

                                <Border Width="80" Height="40" CornerRadius="20"
                                        BorderBrush="{DynamicResource Cheems.Brush.MechanicalToggle.InsetDark}"
                                        BorderThickness="2,2,0,0" IsHitTestVisible="False" />
                                <Border Width="80" Height="40" CornerRadius="20"
                                        BorderBrush="{DynamicResource Cheems.Brush.MechanicalToggle.InsetLight}"
                                        BorderThickness="0,0,2,2" IsHitTestVisible="False" />

                                <!-- slider::before：中心线及上下各偏移 4px 的复制线。 -->
                                <Rectangle x:Name="PartRailTop" Canvas.Left="15" Canvas.Top="15.5"
                                           Width="50" Height="1" IsHitTestVisible="False">
                                    <Rectangle.Fill><SolidColorBrush Color="{StaticResource Cheems.Color.MechanicalToggle.RailOff}" /></Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="PartRailMiddle" Canvas.Left="15" Canvas.Top="19.5"
                                           Width="50" Height="1" IsHitTestVisible="False">
                                    <Rectangle.Fill><SolidColorBrush Color="{StaticResource Cheems.Color.MechanicalToggle.RailOff}" /></Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="PartRailBottom" Canvas.Left="15" Canvas.Top="23.5"
                                           Width="50" Height="1" IsHitTestVisible="False">
                                    <Rectangle.Fill><SolidColorBrush Color="{StaticResource Cheems.Color.MechanicalToggle.RailOff}" /></Rectangle.Fill>
                                </Rectangle>

                                <!-- .glow：40×40、blur(15px)，选中后由 left 0 移至 40。 -->
                                <Ellipse x:Name="PartGlow" Canvas.Left="0" Canvas.Top="0"
                                         Width="40" Height="40"
                                         Fill="{DynamicResource Cheems.Brush.MechanicalToggle.On}"
                                         Opacity="0" IsHitTestVisible="False">
                                    <Ellipse.Effect><BlurEffect Radius="15" /></Ellipse.Effect>
                                </Ellipse>
                            </Canvas>

                            <!-- thumb 两个相反方向的 neumorphic 外阴影。 -->
                            <Border x:Name="PartThumbShadowDark" Canvas.Left="18" Canvas.Top="18"
                                    Width="32" Height="32" CornerRadius="16"
                                    Background="{DynamicResource Cheems.Brush.MechanicalToggle.Background}"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource Cheems.Color.MechanicalToggle.ShadowDark}"
                                                      BlurRadius="10" ShadowDepth="7.1" Direction="315" Opacity="0.72" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="PartThumbShadowLight" Canvas.Left="18" Canvas.Top="18"
                                    Width="32" Height="32" CornerRadius="16"
                                    Background="{DynamicResource Cheems.Brush.MechanicalToggle.Background}"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource Cheems.Color.MechanicalToggle.ShadowLight}"
                                                      BlurRadius="10" ShadowDepth="7.1" Direction="135" Opacity="0.72" />
                                </Border.Effect>
                            </Border>

                            <Grid x:Name="PartThumb" Canvas.Left="18" Canvas.Top="18"
                                  Width="32" Height="32" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform />
                                </Grid.RenderTransform>
                                <Border CornerRadius="16"
                                        Background="{DynamicResource Cheems.Brush.MechanicalToggle.Background}"
                                        BorderBrush="{DynamicResource Cheems.Brush.MechanicalToggle.ThumbBorderOff}"
                                        BorderThickness="1" />
                                <!-- thumb-details::before -->
                                <Ellipse Width="20" Height="20"
                                         Stroke="{DynamicResource Cheems.Brush.MechanicalToggle.Detail}"
                                         StrokeThickness="0.5"
                                         StrokeDashArray="2,2"
                                         IsHitTestVisible="False" />
                                <!-- thumb::after -->
                                <Ellipse x:Name="PartStatusDot" Width="6" Height="6" IsHitTestVisible="False">
                                    <Ellipse.Fill><SolidColorBrush Color="{StaticResource Cheems.Color.MechanicalToggle.Off}" /></Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect x:Name="PartDotGlow"
                                                          Color="{StaticResource Cheems.Color.MechanicalToggle.On}"
                                                          BlurRadius="8" ShadowDepth="0" Opacity="0" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Canvas>
                    </Viewbox>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartThumb" Storyboard.TargetProperty="(Canvas.Left)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="58" KeySpline="0.175,0.885,0.32,1.275" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartThumbShadowDark" Storyboard.TargetProperty="(Canvas.Left)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="58" KeySpline="0.175,0.885,0.32,1.275" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartThumbShadowLight" Storyboard.TargetProperty="(Canvas.Left)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="58" KeySpline="0.175,0.885,0.32,1.275" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartGlow" Storyboard.TargetProperty="(Canvas.Left)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="40" KeySpline="0.175,0.885,0.32,1.275" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartGlow" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.15" KeySpline="0.175,0.885,0.32,1.275" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartTrackGlow" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.2" KeySpline="0.175,0.885,0.32,1.275" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartRailTop" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)">
                                            <SplineColorKeyFrame KeyTime="0:0:0.4" Value="{StaticResource Cheems.Color.MechanicalToggle.RailOn}" KeySpline="0.175,0.885,0.32,1.275" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartRailMiddle" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)">
                                            <SplineColorKeyFrame KeyTime="0:0:0.4" Value="{StaticResource Cheems.Color.MechanicalToggle.RailOn}" KeySpline="0.175,0.885,0.32,1.275" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartRailBottom" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)">
                                            <SplineColorKeyFrame KeyTime="0:0:0.4" Value="{StaticResource Cheems.Color.MechanicalToggle.RailOn}" KeySpline="0.175,0.885,0.32,1.275" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartStatusDot" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)">
                                            <SplineColorKeyFrame KeyTime="0:0:0.4" Value="{StaticResource Cheems.Color.MechanicalToggle.On}" KeySpline="0.175,0.885,0.32,1.275" />
                                        </ColorAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartDotGlow" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1" KeySpline="0.175,0.885,0.32,1.275" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartThumb" Storyboard.TargetProperty="(Canvas.Left)"><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="18" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartThumbShadowDark" Storyboard.TargetProperty="(Canvas.Left)"><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="18" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartThumbShadowLight" Storyboard.TargetProperty="(Canvas.Left)"><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="18" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartGlow" Storyboard.TargetProperty="(Canvas.Left)"><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartGlow" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartTrackGlow" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartRailTop" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"><SplineColorKeyFrame KeyTime="0:0:0.4" Value="{StaticResource Cheems.Color.MechanicalToggle.RailOff}" KeySpline="0.175,0.885,0.32,1.275" /></ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartRailMiddle" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"><SplineColorKeyFrame KeyTime="0:0:0.4" Value="{StaticResource Cheems.Color.MechanicalToggle.RailOff}" KeySpline="0.175,0.885,0.32,1.275" /></ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartRailBottom" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"><SplineColorKeyFrame KeyTime="0:0:0.4" Value="{StaticResource Cheems.Color.MechanicalToggle.RailOff}" KeySpline="0.175,0.885,0.32,1.275" /></ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartStatusDot" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"><SplineColorKeyFrame KeyTime="0:0:0.4" Value="{StaticResource Cheems.Color.MechanicalToggle.Off}" KeySpline="0.175,0.885,0.32,1.275" /></ColorAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartDotGlow" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PartThumbShadowDark" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="{StaticResource Cheems.Color.MechanicalToggle.ShadowDark}" BlurRadius="7" ShadowDepth="5.657" Direction="315" Opacity="0.62" /></Setter.Value>
                            </Setter>
                            <Setter TargetName="PartThumbShadowLight" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="{StaticResource Cheems.Color.MechanicalToggle.ShadowLight}" BlurRadius="7" ShadowDepth="5.657" Direction="135" Opacity="0.62" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PartThumb" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95" /></Setter.Value>
                            </Setter>
                            <Setter TargetName="PartThumbShadowDark" Property="Opacity" Value="0" />
                            <Setter TargetName="PartThumbShadowLight" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PartRoot" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="No" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
