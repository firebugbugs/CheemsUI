<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsMonoProgressBar}">
        <!-- CSS 400×32 content box + 3px border on each side. -->
        <Setter Property="Width" Value="406" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Value" Value="40" />
        <Setter Property="Step" Value="0.1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsMonoProgressBar}">
                    <Border x:Name="PartRoot"
                            Background="{DynamicResource Cheems.Brush.MonoProgress.Background}"
                            BorderBrush="{DynamicResource Cheems.Brush.MonoProgress.Foreground}"
                            BorderThickness="3"
                            SnapsToDevicePixels="True">
                        <Canvas x:Name="PartDragSurface"
                                Width="400" Height="32"
                                Background="{DynamicResource Cheems.Brush.MonoProgress.Background}"
                                ClipToBounds="True">
                            <Grid x:Name="PartProgressFill"
                                  Canvas.Left="0" Canvas.Top="0"
                                  Width="0" Height="32"
                                  Background="{DynamicResource Cheems.Brush.MonoProgress.Foreground}">
                                <!-- progress::after：文字位于当前白色填充区域的中心。 -->
                                <TextBlock x:Name="PartProgressText" Text="{TemplateBinding DisplayText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Cheems.FontFamily.Default}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Cheems.Brush.MonoProgress.Background}"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Canvas>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PartRoot" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
