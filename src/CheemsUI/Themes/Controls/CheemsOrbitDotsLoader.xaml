<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsOrbitDotsLoader}">
        <Setter Property="Width" Value="100" />
        <Setter Property="Height" Value="100" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="WhiteBrush" Value="{DynamicResource Cheems.Brush.OrbitDotsLoader.White}" />
        <Setter Property="RedBrush" Value="{DynamicResource Cheems.Brush.OrbitDotsLoader.Red}" />
        <Setter Property="YellowBrush" Value="{DynamicResource Cheems.Brush.OrbitDotsLoader.Yellow}" />
        <Setter Property="GreenBrush" Value="{DynamicResource Cheems.Brush.OrbitDotsLoader.Green}" />
        <Setter Property="BlueBrush" Value="{DynamicResource Cheems.Brush.OrbitDotsLoader.Blue}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsOrbitDotsLoader}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
