<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <Style TargetType="{x:Type local:CheemsPixelCoinSwitch}">
        <!-- CSS content-box：6em×3.2em + 4px border，按浏览器默认 16px/em 换算。 -->
        <Setter Property="Width" Value="104" />
        <Setter Property="Height" Value="59.2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsPixelCoinSwitch}">
                    <Grid Width="104" Height="59.2" Background="Transparent">
                        <Border x:Name="Track"
                                Background="#FF0E0F12"
                                BorderBrush="#FF16171D"
                                BorderThickness="4"
                                CornerRadius="29.6">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF000000" ShadowDepth="10" BlurRadius="25" Opacity="0.45" />
                            </Border.Effect>
                        </Border>

                        <!-- inset 0 4px 8px rgba(0,0,0,.65) -->
                        <Canvas Width="96" Height="51.2" Margin="4" IsHitTestVisible="False">
                            <Canvas.Clip>
                                <RectangleGeometry Rect="0,0,96,51.2" RadiusX="25.6" RadiusY="25.6" />
                            </Canvas.Clip>
                            <Border Width="112" Height="18" Canvas.Left="-8" Canvas.Top="-7" Background="#A6000000">
                                <Border.Effect><BlurEffect Radius="8" /></Border.Effect>
                            </Border>
                        </Canvas>

                        <Grid x:Name="OnIndicator" Width="13.6" Height="13.6"
                              Margin="18.4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Opacity="0.12" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TransformGroup><ScaleTransform x:Name="OnScale" ScaleX="0.8" ScaleY="0.8"/><RotateTransform x:Name="OnRotate"/></TransformGroup>
                            </Grid.RenderTransform>
                            <Path Stroke="#FF00FFAA" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 1.5,7 L 5.1,10.5 L 12.1,2.8" />
                        </Grid>

                        <Grid x:Name="OffIndicator" Width="13.6" Height="13.6"
                              Margin="0,0,18.4,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Opacity="0.7" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Grid.Effect><DropShadowEffect Color="#FFFF007F" ShadowDepth="0" BlurRadius="3" Opacity="0.4"/></Grid.Effect>
                            <Grid.RenderTransform>
                                <TransformGroup><ScaleTransform x:Name="OffScale" ScaleX="1.1" ScaleY="1.1"/><RotateTransform x:Name="OffRotate"/></TransformGroup>
                            </Grid.RenderTransform>
                            <Path Stroke="#FFFF007F" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 2.2,2.2 L 11.4,11.4 M 11.4,2.2 L 2.2,11.4" />
                        </Grid>

                        <!-- 2.45em content + 2×3.5px border = 46.2px。 -->
                        <Grid x:Name="Thumb" Width="46.2" Height="46.2"
                              Margin="5.92,5.92,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ThumbScale" />
                                    <RotateTransform x:Name="ThumbRotate" />
                                    <TranslateTransform x:Name="ThumbTranslate" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Coin" Fill="#FFFF007F" Stroke="#FF16171D" StrokeThickness="3.5">
                                <Ellipse.Effect><DropShadowEffect x:Name="CoinGlow" Color="#FFFF007F" ShadowDepth="0" BlurRadius="15" Opacity="0.35"/></Ellipse.Effect>
                            </Ellipse>
                            <!-- inset 0 3px 0：只沿硬币上下边缘着色，不再用大椭圆覆盖表情。 -->
                            <Ellipse Margin="3.5" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#47FFFFFF" />
                                        <GradientStop Offset="0.10" Color="#00FFFFFF" />
                                        <GradientStop Offset="0.90" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#47000000" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Canvas ClipToBounds="True" Margin="3.5" IsHitTestVisible="False">
                                <Rectangle x:Name="Shine" Width="23.52" Height="39.2" Canvas.Left="-50.96"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#52FFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform><SkewTransform AngleX="-25"/></Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>

                            <Grid x:Name="SadFace" Width="21.6" Height="21.6" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="SadScale"/><RotateTransform x:Name="SadRotate"/></TransformGroup></Grid.RenderTransform>
                                <Ellipse Width="3.2" Height="3.2" Fill="#FF16171D" Margin="4.2,5.2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Ellipse Width="3.2" Height="3.2" Fill="#FF16171D" Margin="0,5.2,4.2,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                <Path Data="M 5.2,16 C 7.8,11.8 13.8,11.8 16.4,16" Stroke="#FF16171D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <Grid x:Name="HappyFace" Width="21.6" Height="21.6" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="HappyScale" ScaleX="0.7" ScaleY="0.7"/><RotateTransform x:Name="HappyRotate" Angle="180"/></TransformGroup></Grid.RenderTransform>
                                <Ellipse Width="3.2" Height="3.2" Fill="#FF16171D" Margin="4.2,5.2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Ellipse Width="3.2" Height="3.2" Fill="#FF16171D" Margin="0,5.2,4.2,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                <Path Data="M 5.2,12.5 C 7.8,17 13.8,17 16.4,12.5" Stroke="#FF16171D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF0B120F" Duration="0:0:0.4"/>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#FF131715" Duration="0:0:0.4"/>
                                        <ColorAnimation Storyboard.TargetName="Coin" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#FF00FFAA" Duration="0:0:0.4"/>
                                        <ColorAnimation Storyboard.TargetName="CoinGlow" Storyboard.TargetProperty="Color" To="#FF00FFAA" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="CoinGlow" Storyboard.TargetProperty="BlurRadius" To="18" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="CoinGlow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="45.28" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ThumbRotate" Storyboard.TargetProperty="Angle" To="360" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.56" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="(Canvas.Left)" To="50.96" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.56" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnIndicator" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="OnScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="OnScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="OnRotate" Storyboard.TargetProperty="Angle" To="5" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="OffIndicator" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="OffScale" Storyboard.TargetProperty="ScaleX" To="0.8" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="OffScale" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="OffRotate" Storyboard.TargetProperty="Angle" To="-5" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="SadFace" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="SadRotate" Storyboard.TargetProperty="Angle" To="-180" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="SadScale" Storyboard.TargetProperty="ScaleX" To="0.7" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="SadScale" Storyboard.TargetProperty="ScaleY" To="0.7" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="HappyFace" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="HappyRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="HappyScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="HappyScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF0E0F12" Duration="0:0:0.4"/>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#FF16171D" Duration="0:0:0.4"/>
                                        <ColorAnimation Storyboard.TargetName="Coin" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#FFFF007F" Duration="0:0:0.4"/>
                                        <ColorAnimation Storyboard.TargetName="CoinGlow" Storyboard.TargetProperty="Color" To="#FFFF007F" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="CoinGlow" Storyboard.TargetProperty="BlurRadius" To="15" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="CoinGlow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.56" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ThumbRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.56" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="(Canvas.Left)" To="-50.96" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="OnIndicator" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="OnScale" Storyboard.TargetProperty="ScaleX" To="0.8" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="OnScale" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="OnRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="OffIndicator" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="OffScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="OffScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="OffRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="SadFace" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="SadRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="SadScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="SadScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="HappyFace" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="HappyRotate" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="HappyScale" Storyboard.TargetProperty="ScaleX" To="0.7" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="HappyScale" Storyboard.TargetProperty="ScaleY" To="0.7" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.5"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.5"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.18"/>
                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.18"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
