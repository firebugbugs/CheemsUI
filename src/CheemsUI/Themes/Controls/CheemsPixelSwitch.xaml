<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <Style TargetType="{x:Type local:CheemsPixelSwitch}">
        <!-- .switch: width 60px; height 26px. -->
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsPixelSwitch}">
                    <!-- CSS overflow 默认为 visible；28x32 滑块因此高出 26px 轨道 6px。 -->
                    <Grid Width="60"
                          Height="26"
                          Background="Transparent"
                          ClipToBounds="False"
                          SnapsToDevicePixels="True">
                        <!-- .slider: 四边为 0，PNG 原样作为 60x26 背景。 -->
                        <Image x:Name="PartTrack"
                               Width="60"
                               Height="26"
                               Source="/CheemsUI;component/Resources/Images/PixelSwitchTrackOff.png"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               RenderOptions.EdgeMode="Aliased" />

                        <!-- .slider::before: 28x32、bottom 0；translateX(0 -> 32px)。 -->
                        <Image x:Name="PartThumb"
                               Width="28"
                               Height="32"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Source="/CheemsUI;component/Resources/Images/PixelSwitchThumb.png"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               RenderOptions.EdgeMode="Aliased">
                            <Image.RenderTransform>
                                <TranslateTransform X="{Binding ThumbOffset, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PartTrack"
                                    Property="Source"
                                    Value="/CheemsUI;component/Resources/Images/PixelSwitchTrackOn.png" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
