<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Cheems.Style.RotarySwitch.Position" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Cheems.Brush.RotarySwitch.Label}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                      TextElement.FontWeight="{TemplateBinding FontWeight}"
                                      TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter.Effect>
                            <DropShadowEffect BlurRadius="0" Direction="270" ShadowDepth="1"
                                              Color="{StaticResource Cheems.Color.RotarySwitch.TextShadow}" />
                        </ContentPresenter.Effect>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Content" Value="OFF">
                <Setter Property="FontSize" Value="13" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:CheemsRotarySwitch}">
        <Setter Property="Width" Value="230" />
        <Setter Property="Height" Value="230" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectedIndex" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Cheems.Style.RotarySwitch.Position}" />
        <Setter Property="ItemsSource">
            <Setter.Value>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>OFF</sys:String>
                    <sys:String>1</sys:String>
                    <sys:String>2</sys:String>
                    <sys:String>3</sys:String>
                    <sys:String>4</sys:String>
                    <sys:String>5</sys:String>
                </x:Array>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:CheemsRotaryPositionsPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsRotarySwitch}">
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="PartRoot" Width="230" Height="230"
                              Background="{StaticResource Cheems.Brush.RotarySwitch.Transparent}">
                            <!-- .de -->
                            <Ellipse Width="220" Height="220" Fill="{StaticResource Cheems.Brush.RotarySwitch.Shadow}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.1"
                                                      Color="{StaticResource Cheems.Color.RotarySwitch.Shadow}" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- .den -->
                            <Ellipse x:Name="PartDialFace" Width="220" Height="220">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Offset="0" Color="{StaticResource Cheems.Color.RotarySwitch.FaceCenter}" />
                                        <GradientStop Offset="1" Color="{StaticResource Cheems.Color.RotarySwitch.FaceEdge}" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="2"
                                                      Color="{StaticResource Cheems.Color.RotarySwitch.Highlight}" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="220" Height="220" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{StaticResource Cheems.Color.RotarySwitch.InsetShadow}" />
                                        <GradientStop Offset="0.18" Color="{StaticResource Cheems.Color.RotarySwitch.Transparent}" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- hr.line; count follows the number of positions. -->
                            <local:CheemsRotarySpokes Width="220" Height="220"
                                                     IsHitTestVisible="False"
                                                     PositionCount="{Binding Items.Count, RelativeSource={RelativeSource TemplatedParent}}"
                                                     DarkStroke="{StaticResource Cheems.Brush.RotarySwitch.LineDark}"
                                                     LightStroke="{StaticResource Cheems.Brush.RotarySwitch.LineLight}" />

                            <!-- .light -->
                            <Canvas x:Name="PartLight" Width="110" Height="100"
                                    Margin="115,65,5,65" HorizontalAlignment="Stretch"
                                    IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Canvas.RenderTransform>
                                <Ellipse Canvas.Left="15" Width="100" Height="100" Opacity="0.4">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="{StaticResource Cheems.Color.RotarySwitch.GlowCenter}" />
                                            <GradientStop Offset="0.42" Color="{StaticResource Cheems.Color.RotarySwitch.GlowMiddle}" />
                                            <GradientStop Offset="0.72" Color="{StaticResource Cheems.Color.RotarySwitch.GlowOuter}" />
                                            <GradientStop Offset="1" Color="{StaticResource Cheems.Color.RotarySwitch.GlowEdge}" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Canvas>

                            <!-- label/input layer -->
                            <ItemsPresenter Width="220" Height="220" IsHitTestVisible="False" />

                            <!-- .dene / .denem / .deneme -->
                            <Ellipse x:Name="PartKnobOuter" Width="140" Height="140" Panel.ZIndex="4">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{StaticResource Cheems.Color.RotarySwitch.KnobOuterTop}" />
                                        <GradientStop Offset="1" Color="{StaticResource Cheems.Color.RotarySwitch.KnobOuterBottom}" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="13" Direction="270" ShadowDepth="3" Opacity="0.85"
                                                      Color="{StaticResource Cheems.Color.RotarySwitch.Shadow}" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="136" Height="136" Margin="0,2,0,0" Panel.ZIndex="5"
                                     StrokeThickness="2" Stroke="{StaticResource Cheems.Brush.RotarySwitch.KnobHighlight}" />
                            <Ellipse x:Name="PartKnobMiddle" Width="120" Height="120" Panel.ZIndex="5">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{StaticResource Cheems.Color.RotarySwitch.KnobOuterBottom}" />
                                        <GradientStop Offset="1" Color="{StaticResource Cheems.Color.RotarySwitch.KnobOuterTop}" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="PartKnobInner" Width="100" Height="100" Panel.ZIndex="5">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{StaticResource Cheems.Color.RotarySwitch.KnobInnerTop}" />
                                        <GradientStop Offset="1" Color="{StaticResource Cheems.Color.RotarySwitch.KnobInnerBottom}" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="8" Opacity="0.9"
                                                      Color="{StaticResource Cheems.Color.RotarySwitch.Shadow}" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="96" Height="96" Margin="0,2,0,0" Panel.ZIndex="5"
                                     StrokeThickness="2" Stroke="{StaticResource Cheems.Brush.RotarySwitch.KnobHighlightStrong}" />

                            <!-- .dot -->
                            <Canvas x:Name="PartDot" Width="115" Height="12" Margin="115,109,0,109"
                                    HorizontalAlignment="Stretch" Panel.ZIndex="6"
                                    IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Canvas.RenderTransform>
                                <Ellipse Canvas.Left="30" Width="12" Height="12">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="{StaticResource Cheems.Color.RotarySwitch.DotTop}" />
                                            <GradientStop Offset="1" Color="{StaticResource Cheems.Color.RotarySwitch.DotBottom}" />
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
