<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <Style TargetType="{x:Type local:CheemsSaharaButton}">
        <Setter Property="Width" Value="176" />
        <Setter Property="Height" Value="96" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop x:Name="NormalRed" Offset="0" Color="#EF4444" />
                    <GradientStop x:Name="NormalOrange" Offset="1" Color="#F97316" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsSaharaButton}">
                    <Grid Width="176" Height="96">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="48" />
                        </Grid.RowDefinitions>

                        <Border x:Name="MainSurface" Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="24" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#DC2626"
                                                  BlurRadius="20" ShadowDepth="6" Opacity="0.72" />
                            </Border.Effect>
                            <Grid ClipToBounds="True">
                                <!-- Tailwind after: h-[85%] w-[95%] bg-red-200 -->
                                <Border Margin="4.4,3.6" Background="#FECACA" CornerRadius="20.4" />

                                <!-- First SVG: seven translucent Sahara wave layers. -->
                                <Viewbox x:Name="WaveLayers" Stretch="Fill" Opacity="1"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Viewbox.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="-1.25" ScaleY="-1" />
                                            <TranslateTransform x:Name="WaveTranslate" />
                                        </TransformGroup>
                                    </Viewbox.RenderTransform>
                                    <Canvas Width="2400" Height="800">
                                        <Canvas.Resources>
                                            <LinearGradientBrush x:Key="SaharaWaveGradient" StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Offset="0" Color="#FFFFAC" />
                                                <GradientStop Offset="1" Color="#D936B5" />
                                            </LinearGradientBrush>
                                        </Canvas.Resources>
                                        <Path Opacity="0.05" Fill="{StaticResource SaharaWaveGradient}" Data="M0,305.9829 Q227.6032,450 600,302.1755 Q1010.7739,450 1200,343.3024 Q1379.4406,450 1800,320.389 Q2153.5732,450 2400,314.3856 L2400,800 L0,800 Z" Canvas.Top="-56.0878" />
                                        <Path Opacity="0.21" Fill="{StaticResource SaharaWaveGradient}" Data="M0,305.9829 Q227.6032,450 600,302.1755 Q1010.7739,450 1200,343.3024 Q1379.4406,450 1800,320.389 Q2153.5732,450 2400,314.3856 L2400,800 L0,800 Z" Canvas.Top="-21.0878" />
                                        <Path Opacity="0.37" Fill="{StaticResource SaharaWaveGradient}" Data="M0,305.9829 Q227.6032,450 600,302.1755 Q1010.7739,450 1200,343.3024 Q1379.4406,450 1800,320.389 Q2153.5732,450 2400,314.3856 L2400,800 L0,800 Z" Canvas.Top="13.9122" />
                                        <Path Opacity="0.53" Fill="{StaticResource SaharaWaveGradient}" Data="M0,305.9829 Q227.6032,450 600,302.1755 Q1010.7739,450 1200,343.3024 Q1379.4406,450 1800,320.389 Q2153.5732,450 2400,314.3856 L2400,800 L0,800 Z" Canvas.Top="48.9122" />
                                        <Path Opacity="0.68" Fill="{StaticResource SaharaWaveGradient}" Data="M0,305.9829 Q227.6032,450 600,302.1755 Q1010.7739,450 1200,343.3024 Q1379.4406,450 1800,320.389 Q2153.5732,450 2400,314.3856 L2400,800 L0,800 Z" Canvas.Top="83.9122" />
                                        <Path Opacity="0.84" Fill="{StaticResource SaharaWaveGradient}" Data="M0,305.9829 Q227.6032,450 600,302.1755 Q1010.7739,450 1200,343.3024 Q1379.4406,450 1800,320.389 Q2153.5732,450 2400,314.3856 L2400,800 L0,800 Z" Canvas.Top="118.9122" />
                                        <Path Fill="{StaticResource SaharaWaveGradient}" Data="M0,305.9829 Q227.6032,450 600,302.1755 Q1010.7739,450 1200,343.3024 Q1379.4406,450 1800,320.389 Q2153.5732,450 2400,314.3856 L2400,800 L0,800 Z" Canvas.Top="153.9122" />
                                    </Canvas>
                                </Viewbox>

                                <!-- Second SVG foreground dune. -->
                                <Viewbox x:Name="ForegroundDune" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                                    <Viewbox.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="DuneScale" ScaleX="1" ScaleY="1" />
                                            <TranslateTransform x:Name="DuneTranslate" Y="9.6" />
                                        </TransformGroup>
                                    </Viewbox.RenderTransform>
                                    <Canvas Width="1440" Height="320">
                                        <Path Fill="#EF4444" Data="M0,288 L9.2,250.7 C18.5,213 37,139 55,133.3 C73.8,128 92,192 111,224 C129.2,256 148,256 166,256 C184.6,256 203,256 222,250.7 C240,245 258,235 277,213.3 C295.4,192 314,160 332,170.7 C350.8,181 369,235 388,229.3 C406.2,224 425,160 443,122.7 C461.5,85 480,75 498,74.7 C516.9,75 535,85 554,101.3 C572.3,117 591,139 609,170.7 C627.7,203 646,245 665,256 C683.1,267 702,245 720,245.3 C738.5,245 757,267 775,266.7 C793.8,267 812,245 831,234.7 C849.2,224 868,224 886,218.7 C904.6,213 923,203 942,170.7 C960,139 978,85 997,53.3 C1015.4,21 1034,11 1052,48 C1070.8,85 1089,171 1108,197.3 C1126.2,224 1145,192 1163,197.3 C1181.5,203 1200,245 1218,224 C1236.9,203 1255,117 1274,106.7 C1292.3,96 1311,160 1329,170.7 C1347.7,181 1366,139 1385,128 C1403.1,117 1422,139 1431,149.3 L1440,160 L1440,320 L0,320 Z" />
                                    </Canvas>
                                </Viewbox>

                                <TextBlock x:Name="WelcomeText" Text="WELCOME"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="Georgia" FontSize="12" FontWeight="SemiBold"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#EF4444" /><GradientStop Offset="1" Color="#F97316" />
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                    <TextBlock.RenderTransform><TranslateTransform x:Name="WelcomeTranslate" /></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="SaharaText" Text="SAHARA"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="Georgia" FontSize="12" FontWeight="ExtraBold"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#B91C1C" /><GradientStop Offset="1" Color="#C2410C" />
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                    <TextBlock.RenderTransform><TranslateTransform x:Name="SaharaTranslate" Y="36" /></TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- -webkit-box-reflect: below 0 with gradient mask. -->
                        <Rectangle Grid.Row="1" Width="176" Height="48" IsHitTestVisible="False"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="-1" /></Rectangle.RenderTransform>
                            <Rectangle.Fill><VisualBrush Visual="{Binding ElementName=MainSurface}" Stretch="Fill" /></Rectangle.Fill>
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#66000000" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard x:Name="PulseStoryboard">
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="WaveLayers" Storyboard.TargetProperty="Opacity"
                                                     From="0.55" To="1" Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="WaveLayers" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    <DoubleAnimation Storyboard.TargetName="WaveTranslate" Storyboard.TargetProperty="Y" To="2.4" Duration="0:0:0.3" />
                                    <DoubleAnimation Storyboard.TargetName="DuneTranslate" Storyboard.TargetProperty="Y" To="8.5" Duration="0:0:0.5" />
                                    <DoubleAnimation Storyboard.TargetName="DuneScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.5" />
                                    <DoubleAnimation Storyboard.TargetName="DuneScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.5" />
                                    <DoubleAnimation Storyboard.TargetName="WelcomeTranslate" Storyboard.TargetProperty="Y" To="-34" Duration="0:0:0.3" />
                                    <DoubleAnimation Storyboard.TargetName="SaharaTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="WaveTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3" />
                                    <DoubleAnimation Storyboard.TargetName="DuneTranslate" Storyboard.TargetProperty="Y" To="9.6" Duration="0:0:0.5" />
                                    <DoubleAnimation Storyboard.TargetName="DuneScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.5" />
                                    <DoubleAnimation Storyboard.TargetName="DuneScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.5" />
                                    <DoubleAnimation Storyboard.TargetName="WelcomeTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3" />
                                    <DoubleAnimation Storyboard.TargetName="SaharaTranslate" Storyboard.TargetProperty="Y" To="36" Duration="0:0:0.3" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainSurface" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#DC2626" BlurRadius="30" ShadowDepth="7" Opacity="0.9" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#F23838" /><GradientStop Offset="1" Color="#FF6810" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FF2929" /><GradientStop Offset="1" Color="#FF5A00" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
