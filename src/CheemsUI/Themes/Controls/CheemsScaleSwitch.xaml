<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsScaleSwitch}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsScaleSwitch}">
                    <!-- .slider：2em × 2em；transform-origin 默认为中心。 -->
                    <Grid x:Name="PartSlider" Width="34" Height="34"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PartSliderScale" />
                        </Grid.RenderTransform>

                        <Border x:Name="PartTrack" Width="34" Height="34" CornerRadius="17">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource Cheems.Color.ScaleSwitch.Off}" />
                            </Border.Background>
                        </Border>

                        <!-- .slider::before：1.4em，left/bottom 均为 .3em。 -->
                        <Rectangle x:Name="PartInner"
                                   Width="23.8" Height="23.8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RadiusX="2.5" RadiusY="2.5"
                                   Fill="{DynamicResource Cheems.Brush.ScaleSwitch.Inner}"
                                   RenderTransformOrigin="0.5,0.5"
                                   IsHitTestVisible="False">
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PartInnerScale" ScaleX="0" ScaleY="0" />
                                    <RotateTransform x:Name="PartInnerRotation" />
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PartInner" Property="RadiusX" Value="11.9" />
                            <Setter TargetName="PartInner" Property="RadiusY" Value="11.9" />
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartSliderScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.7" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartSliderScale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.7" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartTrack"
                                                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                            <SplineColorKeyFrame KeyTime="0:0:0.4"
                                                                 Value="{StaticResource Cheems.Color.ScaleSwitch.On}"
                                                                 KeySpline="0.25,0.1,0.25,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartInnerScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartInnerScale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartInnerRotation" Storyboard.TargetProperty="Angle">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="360" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartInner" Storyboard.TargetProperty="RadiusX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="11.9" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartInner" Storyboard.TargetProperty="RadiusY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="11.9" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartSliderScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartSliderScale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PartTrack"
                                                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                            <SplineColorKeyFrame KeyTime="0:0:0.4"
                                                                 Value="{StaticResource Cheems.Color.ScaleSwitch.Off}"
                                                                 KeySpline="0.25,0.1,0.25,1" />
                                        </ColorAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartInnerScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartInnerScale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartInnerRotation" Storyboard.TargetProperty="Angle">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartInner" Storyboard.TargetProperty="RadiusX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="2.5" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartInner" Storyboard.TargetProperty="RadiusY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="2.5" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PartSlider" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="No" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
