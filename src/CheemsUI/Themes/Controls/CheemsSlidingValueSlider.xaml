<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <Style TargetType="{x:Type local:CheemsSlidingValueSlider}">
        <Setter Property="Width" Value="390" />
        <Setter Property="Height" Value="112" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Value" Value="40" />
        <Setter Property="Step" Value="1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsSlidingValueSlider}">
                    <Grid Background="Transparent">
                        <Canvas x:Name="PartTrackSurface" Height="112" Background="Transparent">
                            <Border x:Name="PartTrack" Canvas.Top="84" Height="12" CornerRadius="4"
                                    Background="#D4DFFC" />
                            <Border x:Name="PartFill" Canvas.Top="84" Height="12" CornerRadius="4"
                                    Background="#1554F4" />

                            <Ellipse x:Name="PartThumb" Canvas.Top="75" Width="30" Height="30"
                                     Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3"
                                                      BlurRadius="8" Opacity="0.28" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <Grid x:Name="PartOutput" Canvas.Top="4" Width="56" Height="70"
                                  IsHitTestVisible="False">
                                <Border Width="56" Height="56" VerticalAlignment="Top"
                                        CornerRadius="7" Background="#1554F4">
                                    <Canvas Width="56" Height="56" ClipToBounds="True">
                                        <TextBlock x:Name="PartPreviousValue" Width="56" Height="56"
                                                   TextAlignment="Center" LineHeight="56"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   FontSize="19" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock x:Name="PartNextValue" Width="56" Height="56"
                                                   TextAlignment="Center" LineHeight="56"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   FontSize="19" FontWeight="SemiBold" Foreground="White" />
                                    </Canvas>
                                </Border>
                                <Path Margin="0,55,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                      Fill="#1554F4" Data="M 0,0 L 16,0 L 8,9 Z" />
                            </Grid>
                        </Canvas>
                        <Border x:Name="PartDragSurface" Margin="15,60,15,0" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PartThumb" Property="Fill" Value="#F0F2F7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
