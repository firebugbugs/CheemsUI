<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
      DOM 一一对应：PartMachine=.loader；两个 PartFoot=.loader::before 及其 box-shadow；
      PartDoor=.loader::after。根元素背景的六层 background-image 按 CSS 从底到顶拆为独立层。
    -->
    <Style TargetType="{x:Type local:CheemsWashingMachineLoader}">
        <Setter Property="Width" Value="124" />
        <Setter Property="Height" Value="158" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsWashingMachineLoader}">
                    <!-- CSS 主体 120×150；外层仅容纳脚部及绕 (60,180) 摇动的完整包围盒。 -->
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="124" Height="158">
                            <Canvas x:Name="PartMachine" Width="120" Height="155"
                                    Canvas.Left="2" Canvas.Top="1">
                                <Rectangle Width="120" Height="150" RadiusX="7.2" RadiusY="9"
                                           Fill="{DynamicResource Cheems.Brush.WashingMachineLoader.Body}" />

                                <!-- background-image 第 4~6 层：三个 15×15 radial-gradient 控件。 -->
                                <Ellipse Width="15" Height="15" Canvas.Left="55" Canvas.Top="3">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="{StaticResource Cheems.Color.WashingMachineLoader.ControlDark}" />
                                            <GradientStop Offset="0.25" Color="{StaticResource Cheems.Color.WashingMachineLoader.ControlDark}" />
                                            <GradientStop Offset="0.26" Color="{StaticResource Cheems.Color.WashingMachineLoader.ControlLight}" />
                                            <GradientStop Offset="0.50" Color="{StaticResource Cheems.Color.WashingMachineLoader.ControlLight}" />
                                            <GradientStop Offset="0.55" Color="{StaticResource Cheems.Color.Transparent}" />
                                            <GradientStop Offset="1" Color="{StaticResource Cheems.Color.Transparent}" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="15" Height="15" Canvas.Left="75" Canvas.Top="3">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="{StaticResource Cheems.Color.WashingMachineLoader.ControlDark}" />
                                            <GradientStop Offset="0.25" Color="{StaticResource Cheems.Color.WashingMachineLoader.ControlDark}" />
                                            <GradientStop Offset="0.26" Color="{StaticResource Cheems.Color.WashingMachineLoader.ControlLight}" />
                                            <GradientStop Offset="0.50" Color="{StaticResource Cheems.Color.WashingMachineLoader.ControlLight}" />
                                            <GradientStop Offset="0.55" Color="{StaticResource Cheems.Color.Transparent}" />
                                            <GradientStop Offset="1" Color="{StaticResource Cheems.Color.Transparent}" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="15" Height="15" Canvas.Left="95" Canvas.Top="3">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="{StaticResource Cheems.Color.WashingMachineLoader.ControlDark}" />
                                            <GradientStop Offset="0.25" Color="{StaticResource Cheems.Color.WashingMachineLoader.ControlDark}" />
                                            <GradientStop Offset="0.26" Color="{StaticResource Cheems.Color.WashingMachineLoader.ControlLight}" />
                                            <GradientStop Offset="0.50" Color="{StaticResource Cheems.Color.WashingMachineLoader.ControlLight}" />
                                            <GradientStop Offset="0.55" Color="{StaticResource Cheems.Color.Transparent}" />
                                            <GradientStop Offset="1" Color="{StaticResource Cheems.Color.Transparent}" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- background-image 第 3、2 层。 -->
                                <Rectangle Width="30" Height="8" Canvas.Left="8" Canvas.Top="6"
                                           Fill="{DynamicResource Cheems.Brush.WashingMachineLoader.LineLight}" />
                                <Rectangle Width="1" Height="23" Canvas.Left="45" Canvas.Top="0"
                                           Fill="{DynamicResource Cheems.Brush.WashingMachineLoader.LineLight}" />

                                <!-- background-image 第 1 层：#ddd 50% / #bbb 51%。 -->
                                <Rectangle Width="120" Height="4" Canvas.Left="0" Canvas.Top="20">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Offset="0" Color="{StaticResource Cheems.Color.WashingMachineLoader.LineLight}" />
                                            <GradientStop Offset="0.50" Color="{StaticResource Cheems.Color.WashingMachineLoader.LineLight}" />
                                            <GradientStop Offset="0.51" Color="{StaticResource Cheems.Color.WashingMachineLoader.LineDark}" />
                                            <GradientStop Offset="1" Color="{StaticResource Cheems.Color.WashingMachineLoader.LineDark}" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- .loader::before 与它在 x+102 的 box-shadow。 -->
                                <Border Width="7" Height="5" Canvas.Left="5" Canvas.Top="150"
                                        CornerRadius="0,0,4,4"
                                        Background="{DynamicResource Cheems.Brush.WashingMachineLoader.ControlDark}" />
                                <Border Width="7" Height="5" Canvas.Left="107" Canvas.Top="150"
                                        CornerRadius="0,0,4,4"
                                        Background="{DynamicResource Cheems.Brush.WashingMachineLoader.ControlDark}" />

                                <!-- .loader::after：95×95，水平居中，bottom:20。 -->
                                <Canvas x:Name="PartDoor" Width="95" Height="95"
                                        Canvas.Left="12.5" Canvas.Top="35">
                                    <!-- box-sizing:border-box + border:10px solid #ddd。 -->
                                    <Ellipse Width="95" Height="95"
                                             Fill="{DynamicResource Cheems.Brush.WashingMachineLoader.Border}" />

                                    <!-- 75×75 padding box：背景色、135deg 图像、重复 30px 条纹及两层 inset shadow。 -->
                                    <Canvas Width="75" Height="75" Canvas.Left="10" Canvas.Top="10">
                                        <Canvas.Clip>
                                            <EllipseGeometry Center="37.5,37.5" RadiusX="37.5" RadiusY="37.5" />
                                        </Canvas.Clip>
                                        <Ellipse Width="75" Height="75"
                                                 Fill="{DynamicResource Cheems.Brush.WashingMachineLoader.DoorBase}" />

                                        <!-- linear-gradient(135deg,#64b5f6 50%,#607d8b 51%)；size 90×80，无重复。 -->
                                        <Rectangle Width="90" Height="80" Canvas.Left="0" Canvas.Top="0">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Offset="0" Color="{StaticResource Cheems.Color.WashingMachineLoader.WaterLight}" />
                                                    <GradientStop Offset="0.50" Color="{StaticResource Cheems.Color.WashingMachineLoader.WaterLight}" />
                                                    <GradientStop Offset="0.51" Color="{StaticResource Cheems.Color.WashingMachineLoader.WaterDark}" />
                                                    <GradientStop Offset="1" Color="{StaticResource Cheems.Color.WashingMachineLoader.WaterDark}" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>

                                        <!-- repeating linear-gradient：每 30px 的前 49% 为 #0004。 -->
                                        <Rectangle Width="14.7" Height="75" Canvas.Left="0"
                                                   Fill="{DynamicResource Cheems.Brush.WashingMachineLoader.Stripe}" />
                                        <Rectangle Width="14.7" Height="75" Canvas.Left="30"
                                                   Fill="{DynamicResource Cheems.Brush.WashingMachineLoader.Stripe}" />
                                        <Rectangle Width="14.7" Height="75" Canvas.Left="60"
                                                   Fill="{DynamicResource Cheems.Brush.WashingMachineLoader.Stripe}" />

                                        <!-- inset 0 0 6px 6px #0004：边缘 6px 扩散并向内模糊。 -->
                                        <Ellipse Width="75" Height="75" StrokeThickness="12"
                                                 Stroke="{DynamicResource Cheems.Brush.WashingMachineLoader.Stripe}">
                                            <Ellipse.Effect>
                                                <BlurEffect Radius="6" RenderingBias="Quality" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <!-- inset 0 0 0 4px #999 位于前一层上方。 -->
                                        <Ellipse Width="71" Height="71" Canvas.Left="2" Canvas.Top="2"
                                                 StrokeThickness="4"
                                                 Stroke="{DynamicResource Cheems.Brush.WashingMachineLoader.InsetRing}" />
                                    </Canvas>
                                </Canvas>
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
