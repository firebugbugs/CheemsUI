<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Cheems.WaveBarsLoader.Bar" TargetType="Border">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource Cheems.Brush.WaveBarsLoader.Bar}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type local:CheemsWaveBarsLoader}">
        <Setter Property="Width" Value="140" />
        <Setter Property="Height" Value="47" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsWaveBarsLoader}">
                    <StackPanel Width="140" Height="47" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="PartBar1" Style="{StaticResource Cheems.WaveBarsLoader.Bar}" />
                        <Border x:Name="PartBar2" Style="{StaticResource Cheems.WaveBarsLoader.Bar}" />
                        <Border x:Name="PartBar3" Style="{StaticResource Cheems.WaveBarsLoader.Bar}" />
                        <Border x:Name="PartBar4" Style="{StaticResource Cheems.WaveBarsLoader.Bar}" />
                        <Border x:Name="PartBar5" Style="{StaticResource Cheems.WaveBarsLoader.Bar}" />
                        <Border x:Name="PartBar6" Style="{StaticResource Cheems.WaveBarsLoader.Bar}" />
                        <Border x:Name="PartBar7" Style="{StaticResource Cheems.WaveBarsLoader.Bar}" />
                        <Border x:Name="PartBar8" Style="{StaticResource Cheems.WaveBarsLoader.Bar}" />
                        <Border x:Name="PartBar9" Style="{StaticResource Cheems.WaveBarsLoader.Bar}" />
                        <Border x:Name="PartBar10" Style="{StaticResource Cheems.WaveBarsLoader.Bar}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
