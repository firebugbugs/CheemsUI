<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CheemsUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Colors.xaml" />
        <ResourceDictionary Source="/CheemsUI;component/Themes/Basic/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:CheemsWaveProgressBall}">
        <!-- CSS 80px content + 1px transparent border + 2px zero-blur outer spread. -->
        <Setter Property="Width" Value="86" />
        <Setter Property="Height" Value="86" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Value" Value="40" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheemsWaveProgressBall}">
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="PartRoot" Width="86" Height="86">
                            <!-- box-shadow: 0 0 0 2px rgb(25,116,253), plus the 1px transparent border. -->
                            <Ellipse Fill="Transparent"
                                     Stroke="{DynamicResource Cheems.Brush.WaveProgressBall.Ring}"
                                     StrokeThickness="2" />

                            <Canvas Width="80" Height="80"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas.Clip>
                                    <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40" />
                                </Canvas.Clip>

                                <Ellipse Width="80" Height="80"
                                         Fill="{DynamicResource Cheems.Brush.WaveProgressBall.Water}" />

                                <!-- inset 0 0 50px rgba(0,0,0,.3) 的径向等价层。 -->
                                <Ellipse Width="80" Height="80" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Offset="0" Color="{StaticResource Cheems.Color.WaveProgressBall.ShadowTransparent}" />
                                            <GradientStop Offset="0.45" Color="{StaticResource Cheems.Color.WaveProgressBall.ShadowTransparent}" />
                                            <GradientStop Offset="1" Color="{StaticResource Cheems.Color.WaveProgressBall.Shadow}" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- .waves::before：200% × 200%，border-radius:45%，5s linear。 -->
                                <Border x:Name="PartWaveOne"
                                        Canvas.Left="-40" Canvas.Top="-112"
                                        Width="160" Height="160" CornerRadius="72"
                                        Background="{DynamicResource Cheems.Brush.WaveProgressBall.WavePrimary}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="PartWaveOneRotation" />
                                    </Border.RenderTransform>
                                </Border>

                                <!-- .waves::after：200% × 200%，border-radius:40%，10s linear。 -->
                                <Border x:Name="PartWaveTwo"
                                        Canvas.Left="-40" Canvas.Top="-112"
                                        Width="160" Height="160" CornerRadius="64"
                                        Background="{DynamicResource Cheems.Brush.WaveProgressBall.WaveOverlay}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="PartWaveTwoRotation" />
                                    </Border.RenderTransform>
                                </Border>
                            </Canvas>

                            <TextBlock Text="{TemplateBinding DisplayText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Cheems.Brush.WaveProgressBall.Ring}"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>

                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PartWaveOneRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:5"
                                                     RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="PartWaveTwoRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:10"
                                                     RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PartRoot" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
